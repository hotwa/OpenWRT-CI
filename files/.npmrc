# HOME-independent npm guard.  Some boot paths run npm with HOME=/ (an old
# build left a /.npm cache directory behind), and neither /etc/profile.d nor
# the crontab environment reaches procd services.  npm reads /.npmrc for that
# case, so pin the cache away from the root overlay here as well.
cache=/data/cache/npm
fund=false
audit=false
update-notifier=false
