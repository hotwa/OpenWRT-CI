#!/bin/sh
# Multica bootstrap: wait for the exact local runtime, then create one agent.

set -eu

CONFIG="multica"
SECTION="main"
LOG_TAG="multica-bootstrap"
MULTICA_BIN="${MULTICA_BIN:-/usr/local/bin/multica}"
DATA_DIR="${MULTICA_DATA_DIR:-/data/multica}"
PROFILE_BIN="${MULTICA_DEVICE_PROFILE_BIN:-/usr/sbin/multica-device-profile}"
LOCK_DIR="${MULTICA_BOOTSTRAP_LOCK_DIR:-/var/run/multica-agent-bootstrap.lock}"
PYTHON_BIN="${MULTICA_PYTHON_BIN:-/usr/local/bin/python3}"

log() {
	logger -t "$LOG_TAG" "$*"
	printf '[%s] %s\n' "$LOG_TAG" "$*"
}

cfg() {
	local name="$1"
	local default="$2"
	local value
	value="$(uci -q get "$CONFIG.$SECTION.$name" 2>/dev/null || true)"
	[ -n "$value" ] || value="$default"
	printf '%s' "$value"
}

release_lock() {
	rm -f "$LOCK_DIR/pid" 2>/dev/null || true
	rmdir "$LOCK_DIR" 2>/dev/null || true
}

acquire_lock() {
	local old_pid
	mkdir -p "$(dirname "$LOCK_DIR")"
	if mkdir "$LOCK_DIR" 2>/dev/null; then
		printf '%s\n' "$$" > "$LOCK_DIR/pid"
		trap release_lock EXIT HUP INT TERM
		return 0
	fi

	old_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	case "$old_pid" in
		''|*[!0-9]*) old_pid="" ;;
	esac
	if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
		log "another bootstrap instance is already running"
		return 1
	fi

	# Recover only this known stale lock, never a caller-supplied tree.
	rm -f "$LOCK_DIR/pid" 2>/dev/null || true
	rmdir "$LOCK_DIR" 2>/dev/null || true
	mkdir "$LOCK_DIR" 2>/dev/null || return 1
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	trap release_lock EXIT HUP INT TERM
}

server_reachable() {
	local server_url="$1"
	ip route show default 2>/dev/null | grep -q '^default ' || return 1
	command -v curl >/dev/null 2>&1 || return 1
	curl --fail --silent --show-error --location \
		--connect-timeout 5 --max-time 10 \
		--proto '=https' --tlsv1.2 \
		"$server_url" >/dev/null 2>&1
}

# `multica ... list --output json` is a top-level JSON array.  The OpenWrt
# jshn parser does not accept a top-level array, so use the pinned local
# CPython that the init service already requires before starting Bootstrap.
# Only short identity fields are emitted; tabs/newlines are normalized before
# their tab-separated hand-off to ash.
json_runtime_records() {
	"$PYTHON_BIN" - "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    records = json.load(stream)
for item in records if isinstance(records, list) else []:
    device_info = str(item.get("device_info") or "").split(" · ", 1)[0]
    values = [
        item.get("id") or "",
        item.get("name") or "",
        item.get("provider") or "",
        item.get("status") or "",
        device_info,
        item.get("last_seen_at") or "",
        item.get("created_at") or "",
    ]
    values = [str(value).replace("\t", " ").replace("\n", " ") for value in values]
    print("\t".join(values))
PY
}

json_agent_records() {
	"$PYTHON_BIN" - "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    records = json.load(stream)
for item in records if isinstance(records, list) else []:
    fields = ("id", "name", "runtime_id", "status")
    print("\t".join(str(item.get(field) or "").replace("\t", " ").replace("\n", " ") for field in fields))
PY
}

json_object_id() {
	"$PYTHON_BIN" - "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)
if isinstance(value, dict) and value.get("id"):
    print(value["id"])
PY
}

runtime_device_name() {
	local explicit hostname lan_ip site

	explicit="$(cfg device_name '')"
	if [ -n "$explicit" ]; then
		printf '%s' "$explicit" | tr -cs 'A-Za-z0-9_.-' '-'
		return 0
	fi

	hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || true)"
	[ -n "$hostname" ] || hostname="openwrt"
	lan_ip="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
	site=""
	case "$lan_ip" in
		192.168.*.*)
			site="${lan_ip#192.168.}"
			site="${site%%.*}"
			;;
	esac
	if [ -n "$site" ]; then
		printf '%s-%s' "$hostname" "$site" | tr -cs 'A-Za-z0-9_.-' '-'
	else
		printf '%s' "$hostname" | tr -cs 'A-Za-z0-9_.-' '-'
	fi
}

select_runtime_id() {
	local json_file="$1"
	local expected_name="$2"
	local expected_provider="$3"
	local expected_device_name="${4:-}"
	local records tab candidate_id candidate_name candidate_provider candidate_status candidate_device_info candidate_seen candidate_created
	local candidate_identity expected_identity
	local exact_id="" exact_seen="" exact_matches=0 fallback_id="" fallback_seen="" fallback_matches=0

	if ! records="$(json_runtime_records "$json_file")"; then
		return 1
	fi
	tab="$(printf '\t')"
	expected_identity="$(printf '%s' "$expected_device_name" | tr 'A-Z' 'a-z')"
	while IFS="$tab" read -r candidate_id candidate_name candidate_provider candidate_status candidate_device_info candidate_seen candidate_created; do
		if [ "$candidate_name" = "$expected_name" ] && \
			[ "$candidate_provider" = "$expected_provider" ] && \
			[ "$candidate_status" = "online" ] && [ -n "$candidate_id" ]; then
			exact_matches=$((exact_matches + 1))
			if [ -z "$exact_id" ] || [ "$candidate_seen" \> "$exact_seen" ]; then
				exact_id="$candidate_id"
				exact_seen="$candidate_seen"
			fi
		elif [ -n "$expected_identity" ] && \
			[ "$candidate_provider" = "$expected_provider" ] && \
			[ "$candidate_status" = "online" ] && [ -n "$candidate_id" ]; then
			candidate_identity="$(printf '%s' "$candidate_device_info" | sed 's/[[:space:]]*$//' | tr 'A-Z' 'a-z')"
			if [ "$candidate_identity" = "$expected_identity" ]; then
				fallback_matches=$((fallback_matches + 1))
				if [ -z "$fallback_id" ] || [ "$candidate_seen" \> "$fallback_seen" ]; then
					fallback_id="$candidate_id"
					fallback_seen="$candidate_seen"
				fi
			fi
		fi
	done <<EOF
$records
EOF
	if [ "$exact_matches" -ge 1 ]; then
		printf '%s' "$exact_id"
		return 0
	fi
	# A server may change a Runtime's display name after a firmware/runtime update.
	# Its provider-scoped device identity remains stable; select the most recently
	# seen online record so a re-registered runtime wins without a fixed name.
	[ "$fallback_matches" -ge 1 ] || return 1
	printf '%s' "$fallback_id"
}

agent_is_usable() {
	case "$1" in
		active|idle|busy) return 0 ;;
		*) return 1 ;;
	esac
}

select_agent_id() {
	local json_file="$1"
	local expected_name="$2"
	local expected_runtime_id="$3"
	local records tab candidate_id candidate_name candidate_runtime_id candidate_status
	local matched_id="" matches=0

	if ! records="$(json_agent_records "$json_file")"; then
		return 1
	fi
	tab="$(printf '\t')"
	while IFS="$tab" read -r candidate_id candidate_name candidate_runtime_id candidate_status; do
		if [ "$candidate_name" = "$expected_name" ] && \
			[ "$candidate_runtime_id" = "$expected_runtime_id" ] && \
			agent_is_usable "$candidate_status" && [ -n "$candidate_id" ]; then
			matches=$((matches + 1))
			matched_id="$candidate_id"
		fi
	done <<EOF
$records
EOF
	[ "$matches" -eq 1 ] || return 1
	printf '%s' "$matched_id"
}

select_agent_id_by_name() {
	local json_file="$1"
	local expected_name="$2"
	local records tab candidate_id candidate_name candidate_runtime_id candidate_status
	local matched_id="" matches=0

	if ! records="$(json_agent_records "$json_file")"; then
		return 1
	fi
	tab="$(printf '\t')"
	while IFS="$tab" read -r candidate_id candidate_name candidate_runtime_id candidate_status; do
		if [ "$candidate_name" = "$expected_name" ] && \
			agent_is_usable "$candidate_status" && [ -n "$candidate_id" ]; then
			matches=$((matches + 1))
			matched_id="$candidate_id"
		fi
	done <<EOF
$records
EOF
	# A unique same-name Agent is the safe migration target when its runtime id
	# changed.  Multiple matches remain ambiguous and must not be guessed.
	[ "$matches" -eq 1 ] || return 1
	printf '%s' "$matched_id"
}

select_agent_id_by_id() {
	local json_file="$1"
	local expected_id="$2"
	local records tab candidate_id candidate_name candidate_runtime_id candidate_status

	[ -n "$expected_id" ] || return 1
	if ! records="$(json_agent_records "$json_file")"; then
		return 1
	fi
	tab="$(printf '\t')"
	while IFS="$tab" read -r candidate_id candidate_name candidate_runtime_id candidate_status; do
		if [ "$candidate_id" = "$expected_id" ] && agent_is_usable "$candidate_status"; then
			printf '%s' "$candidate_id"
			return 0
		fi
	done <<EOF
$records
EOF
	return 1
}

select_created_agent_id() {
	local json_file="$1" agent_id

	agent_id="$(json_object_id "$json_file" || true)"
	[ -n "$agent_id" ] || return 1
	printf '%s' "$agent_id"
}

state_value() {
	local state_file="$1" key="$2"
	[ -r "$state_file" ] || return 1
	sed -n "s/^${key}=//p" "$state_file" | sed -n '1p'
}

write_agent_state() {
	local state_file="$1" agent_id="$2" runtime_id="$3" instructions_hash="$4" agent_name="$5"
	local temporary="${state_file}.new.$$"

	umask 077
	{
		printf 'agent_id=%s\n' "$agent_id"
		printf 'runtime_id=%s\n' "$runtime_id"
		printf 'instructions_sha256=%s\n' "$instructions_hash"
		printf 'agent_name=%s\n' "$agent_name"
	} > "$temporary"
	mv -f "$temporary" "$state_file"
}

instructions_sha256() {
	sha256sum "$1" 2>/dev/null | awk '{ print $1 }'
}

render_device_profile() {
	[ -x "$PROFILE_BIN" ] || return 1
	MULTICA_DATA_DIR="$DATA_DIR" "$PROFILE_BIN" write
}

dynamic_agent_name() {
	[ -x "$PROFILE_BIN" ] || return 1
	MULTICA_DATA_DIR="$DATA_DIR" "$PROFILE_BIN" agent-name
}

write_success_flag() {
	local flag="$1"
	local temporary="${flag}.new.$$"
	umask 077
	: > "$temporary"
	mv -f "$temporary" "$flag"
}

try_bootstrap() {
	local server_url="$1"
	local expected_runtime_name="$2"
	local expected_provider="$3"
	local agent_name="$4"
	# Keep this optional at the function boundary so an integration mistake cannot
	# kill the first-boot worker under `set -u`.  The caller below always supplies
	# the reviewed instructions path, and an absent/unreadable file simply retries.
	local instructions_file="${5:-}"
	local runtime_json agent_json runtime_id runtime_device instructions instructions_hash
	local state_file state_agent_id state_runtime_id state_hash state_name agent_id

	server_reachable "$server_url" || return 1
	[ -x "$MULTICA_BIN" ] || return 1
	[ -x "$PYTHON_BIN" ] || return 1

	runtime_json="/tmp/multica-runtimes.$$"
	agent_json="/tmp/multica-agents.$$"
	rm -f "$runtime_json" "$agent_json"
	if ! "$MULTICA_BIN" runtime list --output json > "$runtime_json" 2>/dev/null; then
		rm -f "$runtime_json" "$agent_json"
		return 1
	fi
	runtime_device="$(runtime_device_name || true)"
	runtime_id="$(select_runtime_id "$runtime_json" "$expected_runtime_name" "$expected_provider" "$runtime_device" || true)"
	rm -f "$runtime_json"
	[ -n "$runtime_id" ] || return 1

	if ! "$MULTICA_BIN" agent list --output json > "$agent_json" 2>/dev/null; then
		rm -f "$agent_json"
		return 1
	fi

	[ -r "$instructions_file" ] || return 1
	instructions_hash="$(instructions_sha256 "$instructions_file" || true)"
	[ -n "$instructions_hash" ] || {
		rm -f "$agent_json"
		return 1
	}
	state_file="$DATA_DIR/.agent_state"
	state_agent_id="$(state_value "$state_file" agent_id || true)"
	state_runtime_id="$(state_value "$state_file" runtime_id || true)"
	state_hash="$(state_value "$state_file" instructions_sha256 || true)"
	state_name="$(state_value "$state_file" agent_name || true)"
	agent_id="$(select_agent_id_by_id "$agent_json" "$state_agent_id" || true)"
	if [ -z "$agent_id" ]; then
		agent_id="$(select_agent_id "$agent_json" "$agent_name" "$runtime_id" || true)"
	fi
	if [ -z "$agent_id" ]; then
		# Runtime upgrades create a new runtime_id while preserving the Agent.
		# Rebind the unique same-name Agent instead of issuing a duplicate create.
		agent_id="$(select_agent_id_by_name "$agent_json" "$agent_name" || true)"
	fi
	if [ -n "$agent_id" ]; then
		if [ "$state_runtime_id" != "$runtime_id" ] || \
			[ "$state_hash" != "$instructions_hash" ] || \
			[ "$state_name" != "$agent_name" ]; then
			if ! "$MULTICA_BIN" agent update "$agent_id" \
				--name "$agent_name" \
				--runtime-id "$runtime_id" \
				--description "本机 OpenWrt 网络与系统管理智能体" \
				--instructions "$(cat "$instructions_file")" \
				--max-concurrent-tasks 1 >/dev/null 2>&1; then
				rm -f "$agent_json"
				return 1
			fi
		fi
		rm -f "$agent_json"
		write_agent_state "$state_file" "$agent_id" "$runtime_id" "$instructions_hash" "$agent_name"
		return 0
	fi

	instructions="$(cat "$instructions_file")"
	[ -n "$instructions" ] || return 1
	if ! "$MULTICA_BIN" agent create \
		--name "$agent_name" \
		--runtime-id "$runtime_id" \
		--description "OpenWrt 系统与网络管理智能体" \
		--instructions "$instructions" \
		--max-concurrent-tasks 1 --output json > "$agent_json" 2>/dev/null; then
		rm -f "$agent_json"
		return 1
	fi

	agent_id="$(select_created_agent_id "$agent_json" || true)"
	rm -f "$agent_json"
	[ -n "$agent_id" ] || return 1
	write_agent_state "$state_file" "$agent_id" "$runtime_id" "$instructions_hash" "$agent_name"
	return 0
}

main() {
	local enabled server_url expected_runtime_name expected_provider configured_agent_name agent_name
	local instructions_file success_flag delay

	enabled="$(cfg enabled 0)"
	case "$enabled" in
		1|true|yes|on) ;;
		*) return 0 ;;
	esac

	acquire_lock || return 0
	mkdir -p "$DATA_DIR"
	success_flag="$DATA_DIR/.agent_initialized"

	server_url="$(cfg server_url 'https://multica.lucky.jmsu.top')"
	expected_runtime_name="$(cfg runtime_name 'Pi (OpenWrt-Router)')"
	expected_provider="$(cfg runtime_provider 'pi')"
	configured_agent_name="$(cfg agent_name 'OpenWrt 管家')"

	delay=5
	while :; do
		instructions_file=""
		agent_name="$configured_agent_name"
		if render_device_profile; then
			instructions_file="$DATA_DIR/openwrt-agent.md"
			agent_name="$(dynamic_agent_name || true)"
			[ -n "$agent_name" ] || agent_name="$configured_agent_name"
		else
			log "device profile is unavailable; bootstrap will retry"
		fi
		if [ -n "$instructions_file" ] && \
			try_bootstrap "$server_url" "$expected_runtime_name" "$expected_provider" "$agent_name" "$instructions_file"; then
			write_success_flag "$success_flag"
			log "default agent is registered on the expected online runtime"
			return 0
		fi
		log "bootstrap prerequisites are not ready; retrying in ${delay}s"
		sleep "$delay"
		if [ "$delay" -lt 60 ]; then
			delay=$((delay * 2))
			[ "$delay" -le 60 ] || delay=60
		fi
	done
}

if [ "${MULTICA_BOOTSTRAP_LIBRARY_ONLY:-0}" != "1" ]; then
	main "$@"
fi
