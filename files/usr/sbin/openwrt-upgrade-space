#!/bin/sh

# Prepare and validate /tmp for a firmware image that sysupgrade will stage
# there.  RE-SS-01 is the only current 1 GiB device whose sysupgrade image is
# too close to its default tmpfs ceiling.

set -eu

die() {
	echo "openwrt-upgrade-space: ERROR: $*" >&2
	exit 1
}

board="$(cat /tmp/sysinfo/board_name 2>/dev/null || true)"
[ -n "$board" ] || die "cannot determine board name"

is_tmpfs() {

	awk '$2 == "/tmp" && $3 == "tmpfs" { found = 1 } END { exit !found }' /proc/mounts
}

prepare() {
	is_tmpfs || die "/tmp is not a tmpfs mount"
	case "$board" in
		jdcloud,re-ss-01)
			mount -o remount,size=512m /tmp || die "could not raise RE-SS-01 /tmp tmpfs limit to 512 MiB"
			;;
		jdcloud,re-cs-02|jdcloud,re-cs-07)
			;;
		*)
			die "unregistered board: $board"
			;;
	esac
	is_tmpfs || die "/tmp stopped being a tmpfs mount after preparation"
}

case "${1:-}" in
	prepare)
		[ "$#" -eq 1 ] || die "usage: $0 prepare | check IMAGE"
		prepare
		echo "upgrade /tmp prepared for $board"
		;;
	check)
		[ "$#" -eq 2 ] || die "usage: $0 prepare | check IMAGE"
		image="$2"
		[ -f "$image" ] && [ -r "$image" ] || die "firmware image is missing or unreadable: $image"
		prepare
		image_bytes="$(wc -c < "$image" | tr -d '[:space:]')"
		case "$image_bytes" in ''|*[!0-9]*) die "cannot determine image size" ;; esac
		image_kib=$(( (image_bytes + 1023) / 1024 ))
		available_kib="$(df -Pk /tmp | awk 'NR == 2 { print $4 }')"
		case "$available_kib" in ''|*[!0-9]*) die "cannot determine free space on /tmp" ;; esac
		# tmpfs capacity and available physical memory are different limits.
		# zram SwapFree is compressed RAM, not guaranteed extra image capacity.
		# sysupgrade stages non-/tmp images even for -T; a checked /tmp image
		# can be reused without allocating a second copy.
		allocation_kib="$image_kib"
		case "$image" in /tmp/*) allocation_kib=0 ;; esac
		config_kib="$(du -sk /etc | awk 'NR == 1 { print $1 }')"
		case "$config_kib" in ''|*[!0-9]*) die "cannot estimate retained /etc configuration" ;; esac
		required_kib=$(( allocation_kib + config_kib + 98304 ))
		[ "$available_kib" -ge "$required_kib" ] ||
			die "/tmp has ${available_kib} KiB free; ${required_kib} KiB required for allocation, config and 96 MiB reserve"
		memory_kib="$(awk '/^MemAvailable:/ { print $2; found=1 } END { if (!found) exit 1 }' /proc/meminfo)" || die "cannot determine MemAvailable"
		case "$memory_kib" in ''|*[!0-9]*) die "invalid MemAvailable" ;; esac
		[ "$memory_kib" -ge "$required_kib" ] ||
			die "MemAvailable=${memory_kib} KiB; ${required_kib} KiB required; pause applications before retrying (swap is not counted)"
		echo "upgrade space passed: board=$board image=${image_kib}KiB allocation=${allocation_kib}KiB config=${config_kib}KiB required=${required_kib}KiB MemAvailable=${memory_kib}KiB"

		;;
	*)
		die "usage: $0 prepare | check IMAGE"
		;;
esac
