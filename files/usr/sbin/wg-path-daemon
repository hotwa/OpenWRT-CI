#!/bin/sh
# Both sites: admit only a probed direct path; remove only the owned LAN route.
set -u
CFG="${WG_SITE_CONFIG:-/etc/wg-site/site.conf}"
[ -f "$CFG" ] || exit 0
. "$CFG"
case "${ROLE:-}" in server|client) ;; *) exit 1;; esac
STATE="${WG_SITE_STATE:-/var/run/wg-site}"
mkdir -p "$STATE"
INTERVAL=120
[ "$ROLE" = server ] && INTERVAL=60
log() { logger -t wg-path-daemon "$*"; }
clear_lan() {
    ip -4 route del "$WG_REMOTE_NET" dev wg0 table 60 2>/dev/null || true
}
# Resolve only answer records from an explicit resolver; never use a DNS-server
# address, Fake-IP range or a hardcoded historical WAN as the remote endpoint.
resolve_endpoint() {
    [ "$ROLE" = client ] || return 0
    answer=$(nslookup "$DDNS_HOST" 223.5.5.5 2>/dev/null | awk '
        /^Name:/ {answer=1; next}
        answer && /^Address[^:]*:/ {for(i=2;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print $i}')
    for address in $answer; do
        if ! printf '%s\n' "$address" | awk -F. '
          NF!=4 {exit 1} {for(i=1;i<=4;i++) if($i<0 || $i>255) exit 1;
          if($1==0 || $1==10 || $1==127 || $1>=224 || ($1==169&&$2==254) ||
             ($1==172&&$2>=16&&$2<=31) || ($1==192&&$2==168) ||
             ($1==100&&$2>=64&&$2<=127) || ($1==198&&($2==18||$2==19))) exit 1}'
        then continue; fi
        wg set wg0 peer "$WG_PEER_PUB" endpoint "$address:$WG_LISTEN_PORT" || return 1
        return 0
    done
    return 1
}
run_once() {
    exec 9>"$STATE/lock"
    flock -n 9 || return 0
    mode=$(cat "$STATE/manual" 2>/dev/null || echo auto)
    if [ "$mode" = ts ]; then clear_lan; echo ts > "$STATE/state"; return; fi
    # This probe cannot succeed through Tailscale. Keep only the WG tunnel route
    # while the remote LAN remains on the fallback path.
    if ! ip -4 route replace "$WG_TUN_PEER_IP/32" dev wg0 table 60 2>/dev/null; then
        clear_lan
        echo ts > "$STATE/state"
        return
    fi
    if ping -I wg0 -c 1 -W 2 "$WG_TUN_PEER_IP" >/dev/null 2>&1; then
        if ip -4 route replace "$WG_REMOTE_NET" dev wg0 table 60; then
            echo udp > "$STATE/state"
            echo 0 > "$STATE/bad"
        fi
        return
    fi
    resolve_endpoint || true
    bad=$(cat "$STATE/bad" 2>/dev/null || echo 0)
    case "$bad" in ''|*[!0-9]*) bad=0;; esac
    bad=$((bad+1)); echo "$bad" > "$STATE/bad"
    old=$(cat "$STATE/state" 2>/dev/null || echo ts)
    if [ "$bad" -ge 2 ] || [ "$old" != udp ]; then
        clear_lan; echo ts > "$STATE/state"
    fi
    now=$(date +%s)
    handshake=$(wg show wg0 latest-handshakes 2>/dev/null | awk -v peer="$WG_PEER_PUB" '$1==peer {print $2}')
    case "$handshake" in ''|*[!0-9]*) handshake=0;; esac
    last=$(cat "$STATE/restart" 2>/dev/null || echo 0)
    if [ $((now-handshake)) -gt 900 ] && [ $((now-last)) -ge 120 ]; then
        echo "$now" > "$STATE/restart"
        ifup wg0 >/dev/null 2>&1 || true
        log 'direct probe failed and handshake stale; bounded interface recovery'
    fi
}
case "${1:-start}" in
    once) run_once ;;
    start)
        trap 'clear_lan; exit 0' TERM INT
        while :; do (run_once); sleep "$INTERVAL"; done
        ;;
    stop) clear_lan ;;
    manual)
        case "${2:-}" in
          ts) echo ts > "$STATE/manual"; clear_lan;;
          auto|udp) rm -f "$STATE/manual"; (run_once);;
          tcp) log 'TCP carrier is disabled until independently validated'; exit 1;;
          *) exit 64;;
        esac
        ;;
    status) cat "$STATE/state" 2>/dev/null; ip -4 route show table 60 ;;
    *) exit 64;;
esac
