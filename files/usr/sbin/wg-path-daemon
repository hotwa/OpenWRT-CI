#!/bin/sh
# Both sites: admit only a probed direct path; remove only the owned LAN route.
set -u
CFG="${WG_SITE_CONFIG:-/etc/wg-site/site.conf}"
[ -f "$CFG" ] || exit 0
. "$CFG"
case "${ROLE:-}" in server|client) ;; *) exit 1;; esac
STATE="${WG_SITE_STATE:-/var/run/wg-site}"
mkdir -p "$STATE"
INTERVAL=120
[ "$ROLE" = server ] && INTERVAL=60
log() { logger -t wg-path-daemon "$*"; }
clear_lan() {
    ip -4 route del "$WG_REMOTE_NET" dev wg0 table 60 2>/dev/null || true
}
# Endpoint discovery is deliberately disabled. Retain WireGuard's learned
# endpoint and leave address changes to the administrator, never stale DNS/IPs.
run_once() {
    exec 9>"$STATE/lock"
    flock -n 9 || return 0
    mode=$(cat "$STATE/manual" 2>/dev/null || echo auto)
    if [ "$mode" = ts ]; then clear_lan; echo ts > "$STATE/state"; return; fi
    # This probe cannot succeed through Tailscale. Keep only the WG tunnel route
    # while the remote LAN remains on the fallback path.
    if ! ip -4 route replace "$WG_TUN_PEER_IP/32" dev wg0 table 60 2>/dev/null; then
        clear_lan
        echo ts > "$STATE/state"
        return
    fi
    if ping -I wg0 -c 1 -W 2 "$WG_TUN_PEER_IP" >/dev/null 2>&1; then
        if ip -4 route replace "$WG_REMOTE_NET" dev wg0 table 60; then
            echo udp > "$STATE/state"
            echo 0 > "$STATE/bad"
        fi
        return
    fi
    bad=$(cat "$STATE/bad" 2>/dev/null || echo 0)
    case "$bad" in ''|*[!0-9]*) bad=0;; esac
    bad=$((bad+1)); echo "$bad" > "$STATE/bad"
    old=$(cat "$STATE/state" 2>/dev/null || echo ts)
    if [ "$bad" -ge 2 ] || [ "$old" != udp ]; then
        clear_lan; echo ts > "$STATE/state"
    fi
    # Do not ifup here: reloading a stale UCI endpoint can destroy a newer
    # endpoint learned by WireGuard. The probe route permits passive recovery.
}
case "${1:-start}" in
    once) run_once ;;
    start)
        trap 'clear_lan; exit 0' TERM INT
        while :; do (run_once); sleep "$INTERVAL"; done
        ;;
    stop) clear_lan ;;
    manual)
        case "${2:-}" in
          ts) echo ts > "$STATE/manual"; clear_lan;;
          auto|udp) rm -f "$STATE/manual"; (run_once);;
          tcp) log 'TCP carrier is disabled until independently validated'; exit 1;;
          *) exit 64;;
        esac
        ;;
    status) cat "$STATE/state" 2>/dev/null; ip -4 route show table 60 ;;
    *) exit 64;;
esac
