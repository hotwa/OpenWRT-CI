#!/bin/sh
# Private per-site bootstrap. Invoked after persistent storage is ready.
set -eu
umask 077
CFG="${WG_SITE_CONFIG:-/etc/wg-site/site.conf}"
[ -f "$CFG" ] || exit 0
. "$CFG"
case "${ROLE:-}" in server|client) ;; *) exit 1;; esac
DATA="${WG_SITE_DATA:-/data/wg}"
INIT="${WG_SITE_INIT_DIR:-/etc/init.d}"
if [ -z "${WG_SITE_TEST:-}" ]; then
    awk '$2=="/data" && $1 ~ /^\/dev\// && $3 ~ /^(ext4|f2fs)$/ {ok=1} END {exit !ok}' /proc/mounts || {
        logger -t wg-site-init 'persistent /data unavailable; WG held, Tailscale unchanged'
        exit 1
    }
fi
mkdir -p "$DATA"
chmod 700 "$DATA"
KEY="$DATA/wg-$ROLE.key"
if [ -s "$KEY" ]; then
    [ "$(wg pubkey < "$KEY")" = "$WG_LOCAL_PUB" ] || {
        logger -t wg-site-init 'persistent identity mismatch; refusing overwrite'
        exit 1
    }
else
    tmp="$DATA/.key.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$WG_PRIV_KEY" > "$tmp"
    [ "$(wg pubkey < "$tmp")" = "$WG_LOCAL_PUB" ] || exit 1
    mv "$tmp" "$KEY"
    trap - EXIT
fi
chmod 600 "$KEY"
PRIVATE_KEY=$(cat "$KEY")
case "$ROLE" in server) local_addr="$TUN_PREFIX.1/30";; client) local_addr="$TUN_PREFIX.2/32";; esac
# netifd expects an actual key, not a pathname. No secret is passed in argv.
for section in network.wg0.addresses network.wg0_peer_remote; do
    uci -q delete "$section" 2>/dev/null || true
done
uci -q batch <<EOF
set network.wg0=interface
set network.wg0.proto='wireguard'
set network.wg0.private_key='$PRIVATE_KEY'
set network.wg0.listen_port='$WG_LISTEN_PORT'
set network.wg0.mtu='1420'
set network.wg0.auto='1'
set network.wg0.ip4table='60'
add_list network.wg0.addresses='$local_addr'
set network.wg0_peer_remote=wireguard_wg0
set network.wg0_peer_remote.public_key='$WG_PEER_PUB'
set network.wg0_peer_remote.persistent_keepalive='10'
set network.wg0_peer_remote.route_allowed_ips='0'
add_list network.wg0_peer_remote.allowed_ips='$WG_TUN_PEER_IP/32'
add_list network.wg0_peer_remote.allowed_ips='$WG_REMOTE_NET'
set network.wg_site_bypass=rule
set network.wg_site_bypass.ipproto='udp'
set network.wg_site_bypass.sport='$WG_LISTEN_PORT'
set network.wg_site_bypass.lookup='main'
set network.wg_site_bypass.priority='990'
set network.wg_site_tunnel=rule
set network.wg_site_tunnel.dest='$WG_TUN_NET'
set network.wg_site_tunnel.lookup='60'
set network.wg_site_tunnel.priority='1000'
set network.wg_site_remote=rule
set network.wg_site_remote.dest='$WG_REMOTE_NET'
set network.wg_site_remote.lookup='60'
set network.wg_site_remote.priority='1001'
EOF
unset PRIVATE_KEY
if [ "$ROLE" = client ]; then
    uci set "network.wg0_peer_remote.endpoint_host=$DDNS_HOST"
    uci set "network.wg0_peer_remote.endpoint_port=$WG_LISTEN_PORT"
fi
uci commit network
[ -n "${WG_SITE_TEST:-}" ] || chmod 600 /etc/config/network
# Both roles require LAN forwarding; only the public server accepts new WAN UDP.
uci -q delete firewall.wg_in 2>/dev/null || true
uci -q batch <<EOF
set firewall.wg_site=zone
set firewall.wg_site.name='wg_site'
set firewall.wg_site.network='wg0'
set firewall.wg_site.input='ACCEPT'
set firewall.wg_site.output='ACCEPT'
set firewall.wg_site.forward='REJECT'
set firewall.wg_site_lan=forwarding
set firewall.wg_site_lan.src='wg_site'
set firewall.wg_site_lan.dest='lan'
set firewall.lan_wg_site=forwarding
set firewall.lan_wg_site.src='lan'
set firewall.lan_wg_site.dest='wg_site'
EOF
if [ "$ROLE" = server ]; then
    uci -q batch <<EOF
set firewall.wg_in=rule
set firewall.wg_in.name='Allow-WG-site'
set firewall.wg_in.src='wan'
set firewall.wg_in.proto='udp'
set firewall.wg_in.family='ipv4'
set firewall.wg_in.dest_port='$WG_LISTEN_PORT'
set firewall.wg_in.target='ACCEPT'
EOF
fi
# Existing Tailnet zone/ACL stays managed by the firmware gateway reconcile.
for section in tailscale_tailnet_to_lan tailscale_lan_to_tailnet; do
    if uci -q get "firewall.$section" >/dev/null; then
        uci set "firewall.$section.enabled=1"
    fi
done
uci commit firewall
uci set tailscale.settings.accept_routes='1'
uci commit tailscale
# The role-aware daemon owns endpoint recovery. Do not run a second ifdown watchdog.
uci -q set wg_endpoint_watchdog.wg0=instance
uci set wg_endpoint_watchdog.wg0.enabled='0'
uci set wg_endpoint_watchdog.wg0.max_handshake_age='900'
uci commit wg_endpoint_watchdog
"$INIT/firewall" reload
"$INIT/ddns-go" enable
"$INIT/ddns-go" restart
"$INIT/wg-path-daemon" enable
ubus call network reload >/dev/null
ifup wg0
# Do not install an unprobed LAN route; the daemon admits it after a WG-bound ping.
(crontab -l 2>/dev/null | sed '\|/usr/sbin/wg-path-health|d'; printf '%s\n' '*/5 * * * * /usr/sbin/wg-path-health') | crontab -
logger -t wg-site-init 'WG site configured; waiting for direct-path probe, Tailscale preserved'
