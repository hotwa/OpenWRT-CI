#!/bin/sh
# Nightly signed agent-runtime check/upgrade wrapper.
# The agent-runtime manager owns locking, signature verification, atomic switch,
# health checks and rollback; this script only schedules a bounded decision.

set -u

CONFIG="multica"
SECTION="main"
DATA_ROOT="${DATA_ROOT:-/data}"
DATA_DIR="${DATA_DIR:-$DATA_ROOT/multica}"
LOG_DIR="$DATA_DIR/logs"
LOG_FILE="$LOG_DIR/agent-runtime.log"
AUTO_UPGRADE_LOCK_FILE="${AUTO_UPGRADE_LOCK_FILE:-/var/lock/agent-runtime-auto-upgrade.lock}"
MAINTENANCE_LOCK_FILE="${MAINTENANCE_LOCK_FILE:-/var/lock/multica-maintenance.lock}"
RUNTIME_BIN="${RUNTIME_BIN:-/usr/sbin/agent-runtime}"

log() {
	local message="$*"
	if [ -d "$LOG_DIR" ] && [ -w "$LOG_DIR" ]; then
		printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)" "$message" >>"$LOG_FILE"
	fi
	logger -t agent-runtime-auto-upgrade -- "$message" 2>/dev/null || true
	printf '%s\n' "$message"
}

cfg() {
	local value
	value="$(uci -q get "$CONFIG.$SECTION.$1" 2>/dev/null || true)"
	[ -n "$value" ] || value="$2"
	printf '%s' "$value"
}

json_field() {
	local payload="$1" expression="$2"
	command -v jsonfilter >/dev/null 2>&1 || return 1
	jsonfilter -s "$payload" -e "$expression" 2>/dev/null | sed -n '1p'
}

active_tasks() {
	local state_file agent_id tasks
	state_file="$DATA_DIR/.agent_state"
	[ -r "$state_file" ] || return 1
	agent_id="$(sed -n 's/^agent_id=//p' "$state_file" | sed -n '1p')"
	[ -n "$agent_id" ] || return 1
	command -v multica >/dev/null 2>&1 || return 1
	tasks="$(multica agent tasks "$agent_id" --output json 2>/dev/null || true)"
	printf '%s' "$tasks" | grep -Eq '"status"[[:space:]]*:[[:space:]]*"(queued|running|dispatched|in_progress|pending|started|active)"'
}

acquire_maintenance_lock() {
	local attempt=0
	exec 8>"$MAINTENANCE_LOCK_FILE" || return 1
	while [ "$attempt" -lt 12 ]; do
		flock -n 8 && return 0
		attempt=$((attempt + 1))
		sleep 5
	done
	return 1
}

main() {
	local enabled check_output code upgrade_output
	enabled="$(cfg auto_runtime_upgrade 1)"
	case "$enabled" in
		1|true|yes|on) ;;
		*) log "automatic runtime upgrade disabled"; return 0 ;;
	esac

	[ -x "$RUNTIME_BIN" ] || { log "agent-runtime manager unavailable"; return 0; }
	[ -d "$DATA_ROOT" ] && [ -w "$DATA_ROOT" ] || { log "skipping runtime check because /data is unavailable"; return 0; }
	mkdir -p "$(dirname "$AUTO_UPGRADE_LOCK_FILE")" 2>/dev/null || true
	exec 9>"$AUTO_UPGRADE_LOCK_FILE" || { log "cannot open automatic-upgrade lock"; return 0; }
	if ! flock -n 9; then
		log "another automatic runtime-upgrade check is already running"
		return 0
	fi
	mkdir -p "$LOG_DIR" 2>/dev/null || true

	check_output="$("$RUNTIME_BIN" check --json 2>&1 || true)"
	log "check: $check_output"
	code="$(json_field "$check_output" '@.code' || true)"
	case "$code" in
		ok)
			if active_tasks; then
				log "new runtime available but an Agent task is active; deferring upgrade"
				return 0
			fi
			if ! acquire_maintenance_lock; then
				log "runtime upgrade deferred because another mutating maintenance action held the lock for 60 seconds"
				return 0
			fi
			upgrade_output="$("$RUNTIME_BIN" upgrade --json 2>&1 || true)"
			log "upgrade: $upgrade_output"
			;;
		no_update) log "runtime is current" ;;
		busy|no_data|download_failed|signature_failed|incompatible|insufficient_space|health_failed)
			log "runtime check did not authorize upgrade (code=$code)" ;;
		*) log "runtime check returned an unrecognized result; no upgrade attempted" ;;
	esac
}

if [ "${AGENT_RUNTIME_AUTO_UPGRADE_LIBRARY_ONLY:-0}" != "1" ]; then
	main "$@"
fi
