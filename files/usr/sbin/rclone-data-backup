#!/bin/sh
# Snapshot-oriented /data backup. It intentionally uses rclone copy only:
# no mount, sync, or in-place remote deletion can occur during upload.
set -u

CONFIG_NAME="${RCLONE_DATA_BACKUP_CONFIG:-rclone-data-backup.main}"
DEFAULT_MANIFEST=/etc/rclone-data-backup/include.conf
STATUS_FILE="${RCLONE_DATA_BACKUP_STATUS_FILE:-/var/run/agent-data-backup.status}"
STATE_DIR=/data/.rclone-data-backup
REMOTE_BASE=unconfigured
SNAPSHOT=
QUOTA=unavailable

log() { logger -t rclone-data-backup -- "$*" 2>/dev/null || true; printf '%s\n' "rclone-data-backup: $*" >&2; }
uci_get() { uci -q get "$1" 2>/dev/null || true; }
uci_list() { uci -q show "$1" 2>/dev/null | sed -n "s/^$1\.writer_lock='\(.*\)'$/\1/p"; }
now_epoch() { date +%s; }
status_write() {
	# This small, atomic file is the human/role-card contract. Keep it under
	# /var/run so a failed or absent /data mount can still report its decision.
	mkdir -p "$(dirname "$STATUS_FILE")" || return 1
	( umask 077; printf 'status=%s\ntimestamp=%s\nmessage=%s\nremote=%s\nsnapshot=%s\nquota=%s\n' "$1" "$(now_epoch)" "$2" "$REMOTE_BASE" "$SNAPSHOT" "$QUOTA" >"$STATUS_FILE.new.$$" ) && mv "$STATUS_FILE.new.$$" "$STATUS_FILE" || return 1
	# A disabled or failed backup still reports via /var/run, but it must not
	# create a fake /data tree on the root overlay merely to retain details.
	is_real_data_mount || return 0
	mkdir -p "$STATE_DIR" || return 0
	( umask 077; cp "$STATUS_FILE" "$STATE_DIR/status.new.$$" ) && mv "$STATE_DIR/status.new.$$" "$STATE_DIR/status" || return 0
	printf 'rclone_data_backup_last_run_seconds %s\nrclone_data_backup_status{status="%s"} 1\n' "$(now_epoch)" "$1" >"$STATE_DIR/metrics.prom"
}
fail() { status_write error "$1" || true; log "$1"; exit 1; }
valid_component() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1;; *) return 0;; esac; }
valid_relative_path() { case "$1" in ''|/*|*'..'*|*[!A-Za-z0-9._/-]*) return 1;; *) return 0;; esac; }
valid_source() { case "$1" in /*) ;; *) return 1;; esac; case "$1" in *..*|*[[:space:]]*|*'['*|*']'*|*'*'*|*'?'*|/etc/rclone/*|/root/.config/rclone/*) return 1;; esac; }
is_real_data_mount() {
	# A mere `/data` directory, an overlay/bind mount, or tmpfs must not be
	# mistaken for the independently persistent data volume.
	awk '$2 == "/data" && $1 ~ /^\/dev\// && $3 !~ /^(overlay|tmpfs|ramfs|squashfs)$/ { found = 1 } END { exit !found }' /proc/mounts 2>/dev/null
}
validate_sources() {
	local src
	valid_source /data/smb && [ -d /data/smb ] || fail 'invalid or unavailable source: /data/smb'
	[ ! -e "$MANIFEST" ] && return 0
	[ -f "$MANIFEST" ] && [ ! -L "$MANIFEST" ] || fail 'include manifest must be a regular non-symlink file'
	while IFS= read -r src || [ -n "$src" ]; do
		case "$src" in ''|'#'*) continue;; esac
		[ "$src" = /data/smb ] && fail 'manifest must not repeat /data/smb'
		valid_source "$src" && [ -d "$src" ] || fail "invalid or unavailable manifest source: $src"
	done <"$MANIFEST"
}
writer_active() {
	local locks lock
	[ "$DEFER_WRITERS" = 1 ] || return 1
	locks="$(uci_list rclone-data-backup.main)"
	for lock in $locks; do
		[ -n "$lock" ] && [ -e "$lock" ] && return 0
	done
	return 1
}
acquire_lock() { mkdir -p "$(dirname "$LOCK_DIR")" || return 1; mkdir "$LOCK_DIR" 2>/dev/null; }
release_lock() { rmdir "$LOCK_DIR" 2>/dev/null || true; }
safe_sleep_jitter() { [ "$1" = --scheduled ] || return 0; [ "$JITTER" -gt 0 ] || return 0; delay=$(( $(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' ') % (JITTER * 60 + 1) )); sleep "$delay"; }
remote_snapshot_has_success() {
	local marker
	marker="$(timeout "$TIMEOUT" rclone lsf "$1" --include _SUCCESS 2>/dev/null)" || return 2
	[ "$marker" = _SUCCESS ]
}
prune_successful() {
	# Only snapshots with our success marker are candidates. Purge is restricted
	# to exact child paths below this device's snapshots directory.
	local raw successful sorted candidate old
	raw="$STATE_DIR/.retention-raw.$$"
	successful="$STATE_DIR/.retention-successful.$$"
	sorted="$STATE_DIR/.retention-sorted.$$"
	timeout "$TIMEOUT" rclone lsf "$SNAPSHOT_ROOT" --dirs-only >"$raw" 2>/dev/null || { rm -f "$raw"; fail 'cannot list existing snapshots for retention'; }
	: >"$successful" || { rm -f "$raw"; fail 'cannot prepare retention state'; }
	while IFS= read -r candidate; do
		candidate="${candidate%/}"
		valid_component "$candidate" || continue
		remote_snapshot_has_success "$SNAPSHOT_ROOT/$candidate"
		case "$?" in
			0) printf '%s\n' "$candidate" >>"$successful" ;;
			1) : ;; # An incomplete snapshot is never a retention candidate.
			*) rm -f "$raw" "$successful" "$sorted"; fail 'cannot verify snapshot success marker' ;;
		esac
	done <"$raw"
	sort -r "$successful" >"$sorted" || { rm -f "$raw" "$successful" "$sorted"; fail 'cannot sort successful snapshots'; }
	awk -v keep="$RETAIN" 'NR > keep' "$sorted" | while IFS= read -r old; do
		# This loop is intentionally fed from a local file; an error exits this
		# shell before success can be reported.
		[ -n "$old" ] && timeout "$TIMEOUT" rclone purge "$SNAPSHOT_ROOT/$old" || exit 1
	done || { rm -f "$raw" "$successful" "$sorted"; fail 'retention cleanup failed'; }
	rm -f "$raw" "$successful" "$sorted"
}

main() {
	ENABLED="$(uci_get "$CONFIG_NAME.enabled")"; [ "$ENABLED" = 1 ] || { status_write disabled 'disabled by configuration' || true; log 'disabled'; exit 0; }
	REMOTE="$(uci_get "$CONFIG_NAME.remote")"; REMOTE_PATH="$(uci_get "$CONFIG_NAME.remote_path")"; DEVICE_ALIAS="$(uci_get "$CONFIG_NAME.device_alias")"
	TIMEOUT="$(uci_get "$CONFIG_NAME.timeout_seconds")"; JITTER="$(uci_get "$CONFIG_NAME.jitter_max_minutes")"; RETAIN="$(uci_get "$CONFIG_NAME.retain_successful")"
	MANIFEST="$(uci_get "$CONFIG_NAME.include_manifest")"; STATE_DIR="$(uci_get "$CONFIG_NAME.state_dir")"; LOCK_DIR="$(uci_get "$CONFIG_NAME.lock_dir")"; DEFER_WRITERS="$(uci_get "$CONFIG_NAME.defer_if_writer")"
	[ -n "$MANIFEST" ] || MANIFEST="$DEFAULT_MANIFEST"
	valid_component "$REMOTE" && valid_relative_path "$REMOTE_PATH" && valid_component "$DEVICE_ALIAS" || { log 'invalid remote selection or device_alias'; exit 2; }
	case "$TIMEOUT:$JITTER:$RETAIN" in *[!0-9:]*|:*|*::*) log 'invalid numeric configuration'; exit 2;; esac
	[ "$TIMEOUT" -ge 60 ] && [ "$TIMEOUT" -le 86400 ] && [ "$JITTER" -le 20 ] && [ "$RETAIN" -eq 3 ] || { log 'timeout/jitter/retention outside policy'; exit 2; }
	is_real_data_mount || fail '/data is not a real mount; refusing backup'
	validate_sources
	REMOTE_BASE="$REMOTE:$REMOTE_PATH/$DEVICE_ALIAS"; SNAPSHOT_ROOT="$REMOTE_BASE/snapshots"; QUOTA="$(timeout "$TIMEOUT" rclone about "$REMOTE_BASE" 2>/dev/null | tr '\n' ';' || true)"; [ -n "$QUOTA" ] || QUOTA=unavailable
	acquire_lock || { log 'another run is active'; exit 0; }; trap release_lock EXIT HUP INT TERM
	if writer_active; then status_write deferred 'active writer lock present' || true; log 'deferred due to active writer'; exit 0; fi
	safe_sleep_jitter "${1:-}"; writer_active && { status_write deferred 'writer became active during jitter' || true; exit 0; }
	SNAPSHOT="$(date -u +%Y%m%dT%H%M%SZ)-$(cat /proc/sys/kernel/random/uuid 2>/dev/null | cut -c1-8)"; valid_component "$SNAPSHOT" || fail 'could not create safe snapshot id'
	DEST="$SNAPSHOT_ROOT/$SNAPSHOT"; timeout "$TIMEOUT" rclone mkdir "$DEST" || fail 'cannot create snapshot directory'
	backup_source() { src="$1"; label="$2"; valid_source "$src" && [ -d "$src" ] || fail "invalid or unavailable source: $src"; timeout "$TIMEOUT" rclone copy "$src" "$DEST/$label" --create-empty-src-dirs || fail "copy failed: $src"; }
	backup_source /data/smb data/smb
	if [ -f "$MANIFEST" ]; then while IFS= read -r src || [ -n "$src" ]; do case "$src" in ''|'#'*) continue;; esac; label="roots/${src#/}"; backup_source "$src" "$label"; done <"$MANIFEST"; fi
	printf 'completed_at=%s\nsource=data/smb\n' "$(date -u +%FT%TZ)" | timeout "$TIMEOUT" rclone rcat "$DEST/_SUCCESS" || fail 'cannot write success marker'
	prune_successful
	status_write success 'snapshot completed' || true; log "snapshot completed: $SNAPSHOT"
}
main "$@"
