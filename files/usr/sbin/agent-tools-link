#!/bin/sh
# Bind the shared Agent Skills directory into Pi and CommandCode without
# replacing administrator-owned entries. CommandCode's MCP file is linked
# only when a shared, non-secret mcp.json has been created by the administrator.

set -u

SHARED_ROOT="${AGENT_TOOLS_ROOT:-/data/shared/agent-tools}"
SHARED_SKILLS="$SHARED_ROOT/skills"
SHARED_MCP="$SHARED_ROOT/mcp.json"
PI_SKILLS="${PI_SKILLS_DIR:-/data/pi/agent/skills}"
COMMANDCODE_SKILLS="${COMMANDCODE_SKILLS_DIR:-/data/commandcode/skills}"
COMMANDCODE_MCP="${COMMANDCODE_MCP_FILE:-/data/commandcode/mcp.json}"
README_SOURCE="${AGENT_TOOLS_README_SOURCE:-/etc/agent-tools/README.md}"

log_message() {
	logger -t agent-tools-link -- "$*" 2>/dev/null || true
	printf '%s\n' "agent-tools-link: $*" >&2
}

ensure_directory() {
	[ -d "$1" ] || mkdir -p "$1"
}

link_skill_entries() {
	local target="$1" skill name entry temporary
	if [ -L "$target" ]; then
		[ "$(readlink "$target")" = "$SHARED_SKILLS" ] || \
			log_message "leaving existing skills symlink unchanged: $target"
		return 0
	fi
	if [ ! -e "$target" ]; then
		temporary="${target}.new.$$"
		ln -s "$SHARED_SKILLS" "$temporary" || return 1
		mv "$temporary" "$target" || { rm -f "$temporary"; return 1; }
		return 0
	fi
	[ -d "$target" ] || {
		log_message "leaving non-directory skills path unchanged: $target"
		return 0
	}
	for skill in "$SHARED_SKILLS"/*; do
		[ -f "$skill/SKILL.md" ] || continue
		name="${skill##*/}"
		entry="$target/$name"
		if [ -e "$entry" ] || [ -L "$entry" ]; then
			continue
		fi
		temporary="${entry}.new.$$"
		ln -s "$skill" "$temporary" || return 1
		mv "$temporary" "$entry" || { rm -f "$temporary"; return 1; }
	done
}

link_shared_mcp() {
	local temporary
	[ -f "$SHARED_MCP" ] || return 0
	if [ -L "$COMMANDCODE_MCP" ]; then
		[ "$(readlink "$COMMANDCODE_MCP")" = "$SHARED_MCP" ] || \
			log_message "leaving existing MCP symlink unchanged: $COMMANDCODE_MCP"
		return 0
	fi
	[ ! -e "$COMMANDCODE_MCP" ] || {
		log_message "leaving existing MCP file unchanged: $COMMANDCODE_MCP"
		return 0
	}
	temporary="${COMMANDCODE_MCP}.new.$$"
	ln -s "$SHARED_MCP" "$temporary" || return 1
	mv "$temporary" "$COMMANDCODE_MCP" || { rm -f "$temporary"; return 1; }
}

main() {
	ensure_directory "$SHARED_SKILLS" || return 1
	ensure_directory "$(dirname "$PI_SKILLS")" || return 1
	ensure_directory "$(dirname "$COMMANDCODE_SKILLS")" || return 1
	if [ -r "$README_SOURCE" ] && [ ! -e "$SHARED_ROOT/README.md" ]; then
		cp -p "$README_SOURCE" "$SHARED_ROOT/README.md" || return 1
	fi
	link_skill_entries "$PI_SKILLS" || return 1
	link_skill_entries "$COMMANDCODE_SKILLS" || return 1
	link_shared_mcp || return 1
}

main "$@"
