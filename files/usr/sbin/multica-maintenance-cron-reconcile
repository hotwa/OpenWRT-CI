#!/bin/sh
# Keep Multica maintenance schedules converged after both first boot and
# sysupgrade. uci-defaults is one-shot; agent-data-prep calls this helper on
# every boot for retained /data installations.

CRONTAB_FILE="${CRONTAB_FILE:-/etc/crontabs/root}"
AUTO_UPGRADE_COMMAND='/usr/sbin/agent-runtime-auto-upgrade'
AUTO_UPGRADE_NEW='7 3 * * * /usr/sbin/agent-runtime-auto-upgrade'
RUNTIME_VERIFY_COMMAND='/usr/sbin/agent-runtime-health-check'
RUNTIME_VERIFY_NEW='53 2 * * * /usr/sbin/agent-runtime-health-check'
RUNTIME_GUARD='*/5 * * * * /usr/sbin/multica-runtime-guard #multica runtime guard'
LOG_HYGIENE='*/30 * * * * /usr/sbin/multica-log-hygiene #multica log hygiene'

case "$CRONTAB_FILE" in
	*/*)
		cron_dir=${CRONTAB_FILE%/*}
		[ -n "$cron_dir" ] || cron_dir=/
		cron_name=${CRONTAB_FILE##*/}
		;;
	*)
		cron_dir=.
		cron_name=$CRONTAB_FILE
		;;
esac

cron_tmp=''
cleanup_cron_tmp() {
	[ -n "$cron_tmp" ] || return 0
	rm -f "$cron_tmp" >/dev/null 2>&1 || true
}
fail_cron_update() {
	printf '%s\n' "multica-maintenance-cron: $*" >&2
	exit 1
}
trap cleanup_cron_tmp 0
trap 'exit 1' 1 2 15

mkdir -p "$cron_dir" || fail_cron_update "cannot create $cron_dir"
[ ! -L "$CRONTAB_FILE" ] || fail_cron_update "refusing symlinked crontab"
touch "$CRONTAB_FILE" || fail_cron_update "cannot create or update $CRONTAB_FILE"
[ -f "$CRONTAB_FILE" ] && [ ! -L "$CRONTAB_FILE" ] || fail_cron_update "crontab is not a regular file"

# Every active schedule for this owned command is removed first, so old, new,
# custom, duplicate, and mixed inputs converge to one canonical 03:07 entry.
# Comments and unrelated entries retain their original content.
cron_tmp="$cron_dir/.${cron_name}.tmp.$$"
(umask 077; : >"$cron_tmp") || fail_cron_update "cannot create temporary crontab"
awk -v upgrade="$AUTO_UPGRADE_COMMAND" -v verify="$RUNTIME_VERIFY_COMMAND" '
	$1 !~ /^#/ && ($6 == upgrade || $6 == verify) { next }
	{ print }
' "$CRONTAB_FILE" >"$cron_tmp" || fail_cron_update "cannot filter existing crontab"
printf '%s\n' "$AUTO_UPGRADE_NEW" >>"$cron_tmp" || fail_cron_update "cannot append the canonical auto-upgrade schedule"
printf '%s\n' "$RUNTIME_VERIFY_NEW" >>"$cron_tmp" || fail_cron_update "cannot append the runtime verification schedule"

grep -Fq '#multica runtime guard' "$cron_tmp" 2>/dev/null
grep_status=$?
if [ "$grep_status" -eq 1 ]; then
	printf '%s\n' "$RUNTIME_GUARD" >>"$cron_tmp" || fail_cron_update "cannot append the runtime guard schedule"
elif [ "$grep_status" -ne 0 ]; then
	fail_cron_update "cannot inspect the runtime guard schedule"
fi
grep -Fq '#multica log hygiene' "$cron_tmp" 2>/dev/null
grep_status=$?
if [ "$grep_status" -eq 1 ]; then
	printf '%s\n' "$LOG_HYGIENE" >>"$cron_tmp" || fail_cron_update "cannot append the log hygiene schedule"
elif [ "$grep_status" -ne 0 ]; then
	fail_cron_update "cannot inspect the log hygiene schedule"
fi

awk -v command="$AUTO_UPGRADE_COMMAND" -v canonical="$AUTO_UPGRADE_NEW" '
	$1 !~ /^#/ && $6 == command {
		owned++
		if ($0 == canonical) exact++
	}
	END { exit !(owned == 1 && exact == 1) }
' "$cron_tmp" || fail_cron_update "staged crontab failed validation"
awk -v command="$RUNTIME_VERIFY_COMMAND" -v canonical="$RUNTIME_VERIFY_NEW" '
	$1 !~ /^#/ && $6 == command {
		owned++
		if ($0 == canonical) exact++
	}
	END { exit !(owned == 1 && exact == 1) }
' "$cron_tmp" || fail_cron_update "staged runtime verification schedule failed validation"

if cmp -s "$CRONTAB_FILE" "$cron_tmp"; then
	cleanup_cron_tmp
	cron_tmp=''
	exit 0
fi
mv -f "$cron_tmp" "$CRONTAB_FILE" || fail_cron_update "cannot publish the staged crontab"
cron_tmp=''

# Restart only an already-running daemon: safe during early first boot while
# making a corrected schedule live as soon as a sysupgrade completes.
if [ -x /etc/init.d/cron ] && /etc/init.d/cron running >/dev/null 2>&1; then
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi
