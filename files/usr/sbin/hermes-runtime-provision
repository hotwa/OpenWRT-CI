#!/bin/sh
# Coordinate and verify the immutable, offline Hermes Core runtime.
# No npm/uv/git/curl is invoked here: new devices must work with no WAN and an
# empty /data. Signed runtime generations are installed by agent-runtime.
set -eu

PATH="/opt/node/bin:/usr/bin:/bin"
export PATH

POLICY_FILE="${HERMES_RUNTIME_POLICY:-/etc/agent-runtime/agent-update.env}"
CORE_MANIFEST="${HERMES_CORE_MANIFEST:-/opt/agent-runtime/hermes-core.json}"
BASELINE_ROOT="/opt/node/lib/node_modules/hermes-agent/runtime/hermes-agent"
RUNTIME_ROOT="${HERMES_RUNTIME_ROOT:-}"
AGENT_RUNTIME_ROOT="${HERMES_AGENT_RUNTIME_ROOT:-/data/agent-runtime}"
STATE_FILE="${HERMES_RUNTIME_STATE:-/tmp/hermes-runtime.status}"
LOG_FILE="${HERMES_RUNTIME_LOG:-/tmp/hermes-runtime.log}"

log() {
	printf '%s hermes-runtime: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$LOG_FILE"
}

write_state() {
	# /tmp is available before /data. A runtime manager can override this after
	# it has validated its own operation directory.
	( umask 077; printf '%s\n' "$1" >"${STATE_FILE}.new.$$" && mv -f "${STATE_FILE}.new.$$" "$STATE_FILE" ) || true
}

read_policy() {
	[ -r "$POLICY_FILE" ] || return 1
	# shellcheck disable=SC1090
	. "$POLICY_FILE"
	[ "${HERMES_RUNTIME_MODE:-}" = "core-offline" ] || return 1
	case "${HERMES_NPM_VERSION:-}" in [0-9]*.[0-9]*.[0-9]*) ;; *) return 1 ;; esac
	case "${HERMES_PYTHON_SERIES:-}" in 3.[0-9]*) ;; *) return 1 ;; esac
}

manifest_value() {
	key="$1"
	[ -r "$CORE_MANIFEST" ] || return 1
	# Builder-produced string values only; never evaluate metadata as shell.
	sed -n "s/^[[:space:]]*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\"[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p" "$CORE_MANIFEST" | sed -n '1p'
}

resolve_runtime_root() {
	if [ -n "$RUNTIME_ROOT" ]; then
		case "$RUNTIME_ROOT" in /opt/*|/data/agent-runtime/generations/*) printf '%s\n' "$RUNTIME_ROOT"; return 0 ;; *) return 1 ;; esac
	fi
	# agent-runtime owns this link and changes it atomically. Never follow a
	# link escaping its generations directory; a damaged /data simply falls
	# through to the immutable /opt baseline.
	if [ -L "$AGENT_RUNTIME_ROOT/current" ]; then
		active_target="$(readlink "$AGENT_RUNTIME_ROOT/current" 2>/dev/null || true)"
		case "$active_target" in
			generations/*) active_root="$AGENT_RUNTIME_ROOT/$active_target" ;;
			"$AGENT_RUNTIME_ROOT"/generations/*) active_root="$active_target" ;;
			*) active_root="" ;;
		esac
		if [ -n "${active_root:-}" ] && [ -d "$active_root/node/lib/node_modules/hermes-agent/runtime/hermes-agent" ]; then
			printf '%s\n' "$active_root/node/lib/node_modules/hermes-agent/runtime/hermes-agent"
			return 0
		fi
	fi
	root_from_manifest="$(manifest_value core_root || true)"
	case "$root_from_manifest" in /opt/*) printf '%s\n' "$root_from_manifest"; return 0 ;; esac
	printf '%s\n' "$BASELINE_ROOT"
}

safe_runtime_root() {
	case "$1" in
		/opt/node/lib/node_modules/hermes-agent/runtime/hermes-agent|/data/agent-runtime/generations/*/node/lib/node_modules/hermes-agent/runtime/hermes-agent) return 0 ;;
		*) return 1 ;;
	esac
}

ready() {
	root="$1"
	python="$root/venv/bin/python"
	hermes="$root/venv/bin/hermes"
	[ -d "$root" ] && [ ! -L "$root" ] || return 1
	[ -f "$root/uv.lock" ] || return 1
	[ -x "$python" ] && [ -x "$hermes" ] || return 1
	timeout 90 "$python" -c 'import hermes_cli.main' >/dev/null 2>&1 || return 1
	timeout 90 "$hermes" --version >/dev/null 2>&1 || return 1
}

main() {
	read_policy || { log "offline Core policy is missing or invalid"; write_state 'failed policy'; return 1; }
	root="$(resolve_runtime_root)" || { log "refusing an unsafe Hermes runtime root"; write_state 'failed unsafe-root'; return 1; }
	safe_runtime_root "$root" || { log "runtime root is outside baseline/active generation: $root"; write_state 'failed unsafe-root'; return 1; }
	if ready "$root"; then
		log "offline Hermes Core healthy at $root"
		write_state "ok $root"
		return 0
	fi
	log "offline Hermes Core health check failed at $root; no network provisioning will be attempted"
	write_state "failed health $root"
	return 1
}

main "$@"
