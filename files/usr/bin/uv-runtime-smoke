#!/bin/sh
set -eu

[ -f /tmp/uv-env.sh ] && . /tmp/uv-env.sh

uv --version
python3 --version

# The point is to prove uv provisions a managed interpreter from the immutable
# offline mirror rather than the network, so the series must come from the manifest.
managed_series="$(awk -F'\t' 'NF >= 4 { series = $1 } END { print series }' /opt/uv/python-mirror/manifest.txt)"
[ -n "$managed_series" ] || {
	echo "ERROR: offline CPython mirror has no managed interpreter to smoke test" >&2
	exit 1
}

rm -rf /tmp/uv-smoke-venv /tmp/uv-managed-smoke
python3 -m venv /tmp/uv-smoke-venv
uv venv --python "$managed_series" /tmp/uv-managed-smoke
