#!/bin/sh
# opencode wrapper - ensures the runtime is installed, then execs the real binary.
#
# This is the user-facing entry point.  On first invocation it triggers a
# foreground install (the user is waiting), then execs the real binary with
# data-backed XDG directories and LSP downloads disabled.

REAL_BIN="/data/opt/opencode/current/bin/opencode"
RUNTIME_MGR="/usr/sbin/opencode-runtime"

# opencode is intentionally not provisioned on low-memory devices (re-ss-01,
# 896MB RAM): firmware built for that board ships without release metadata.
if [ ! -f /etc/opencode/release-url ]; then
	echo "opencode: not enabled on this device (low-memory board build)" >&2
	exit 1
fi

# Ensure runtime is installed (foreground; user is waiting).
if [ ! -x "$REAL_BIN" ]; then
	if [ -x "$RUNTIME_MGR" ]; then
		echo "opencode: runtime not found, installing..." >&2
		if ! "$RUNTIME_MGR" install; then
			echo "opencode: FATAL - runtime installation failed" >&2
			exit 1
		fi
	else
		echo "opencode: FATAL - runtime manager not found at $RUNTIME_MGR" >&2
		exit 1
	fi
fi

[ -x "$REAL_BIN" ] || {
	echo "opencode: FATAL - binary not executable at $REAL_BIN after install" >&2
	exit 1
}

# Default environment: disable LSP auto-download (saves memory/bandwidth on
# routers) and point XDG dirs at /data so config/cache survives upgrades.
export OPENCODE_DISABLE_LSP_DOWNLOAD="${OPENCODE_DISABLE_LSP_DOWNLOAD:-1}"

if [ -d /data ] && [ -w /data ]; then
	export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/data/opencode/config}"
	export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/data/opencode/cache}"
	export XDG_DATA_HOME="${XDG_DATA_HOME:-/data/opencode/data}"
	export XDG_STATE_HOME="${XDG_STATE_HOME:-/data/opencode/state}"
	mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" 2>/dev/null || true
fi

# Inject CommandCode API key from auth.json at runtime (never baked into firmware).
# opencode.json references it via {env:COMMANDCODE_API_KEY}.  Read from /data
# first (persistent, synced by 99-auto-mount-data), fall back to /etc default.
if [ -z "${COMMANDCODE_API_KEY:-}" ]; then
	_CC_AUTH=""
	if [ -r /data/commandcode/auth.json ]; then
		_CC_AUTH="/data/commandcode/auth.json"
	elif [ -r /etc/commandcode/auth.json ]; then
		_CC_AUTH="/etc/commandcode/auth.json"
	fi
	if [ -n "$_CC_AUTH" ]; then
		_CC_KEY="$(sed -n 's/.*"apiKey"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_CC_AUTH" | head -1)"
		if [ -n "$_CC_KEY" ]; then
			export COMMANDCODE_API_KEY="$_CC_KEY"
		fi
		unset _CC_KEY
	fi
	unset _CC_AUTH
fi

# Clean up stale opencode lock files left behind by killed processes
# (SSH disconnect, timeout, OOM kill).  Each .lock is a JSON file with a
# "pid" field; when that pid is no longer alive the lock is orphaned and
# every new `opencode run` blocks until its internal lock timeout, which
# exceeds multica's 6s per-task budget and causes exit 1.
cleanup_stale_locks() {
	[ -n "${XDG_STATE_HOME:-}" ] || return 0
	local lock_dir="$XDG_STATE_HOME/opencode/locks"
	local lockfile pid cleaned=0
	[ -d "$lock_dir" ] || return 0
	for lockfile in "$lock_dir"/*.lock; do
		[ -f "$lockfile" ] || continue
		pid="$(sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$lockfile" 2>/dev/null | head -1)"
		[ -n "$pid" ] || continue
		[ "$pid" -gt 0 ] 2>/dev/null || continue
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$lockfile"
			cleaned=1
		fi
	done
	# If any stale lock was removed, the owning process is gone and its
	# SQLite WAL/SHM sidecars are also orphaned.  Remove them so the next
	# instance starts clean; SQLite recreates them on first write.
	if [ "$cleaned" -eq 1 ] && [ -n "${XDG_DATA_HOME:-}" ]; then
		rm -f "$XDG_DATA_HOME/opencode/opencode.db-wal" \
		      "$XDG_DATA_HOME/opencode/opencode.db-shm" 2>/dev/null || true
	fi
}
cleanup_stale_locks

exec "$REAL_BIN" "$@"
