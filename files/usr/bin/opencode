#!/bin/sh
# opencode wrapper - ensures the runtime is installed, then execs the real binary.
#
# This is the user-facing entry point.  On first invocation it triggers a
# foreground install (the user is waiting), then execs the real binary with
# data-backed XDG directories and LSP downloads disabled.

REAL_BIN="/data/opt/opencode/current/bin/opencode"
RUNTIME_MGR="/usr/sbin/opencode-runtime"

# Ensure runtime is installed (foreground; user is waiting).
if [ ! -x "$REAL_BIN" ]; then
	if [ -x "$RUNTIME_MGR" ]; then
		echo "opencode: runtime not found, installing..." >&2
		if ! "$RUNTIME_MGR" install; then
			echo "opencode: FATAL - runtime installation failed" >&2
			exit 1
		fi
	else
		echo "opencode: FATAL - runtime manager not found at $RUNTIME_MGR" >&2
		exit 1
	fi
fi

[ -x "$REAL_BIN" ] || {
	echo "opencode: FATAL - binary not executable at $REAL_BIN after install" >&2
	exit 1
}

# Default environment: disable LSP auto-download (saves memory/bandwidth on
# routers) and point XDG dirs at /data so config/cache survives upgrades.
export OPENCODE_DISABLE_LSP_DOWNLOAD="${OPENCODE_DISABLE_LSP_DOWNLOAD:-1}"

if [ -d /data ] && [ -w /data ]; then
	export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/data/opencode/config}"
	export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/data/opencode/cache}"
	export XDG_DATA_HOME="${XDG_DATA_HOME:-/data/opencode/data}"
	export XDG_STATE_HOME="${XDG_STATE_HOME:-/data/opencode/state}"
	mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME" 2>/dev/null || true
fi

exec "$REAL_BIN" "$@"
