#!/bin/sh

[ "$ACTION" = "ifup" ] || exit 0
[ -x /etc/init.d/headscale-auto-enroll ] || exit 0

# This is a bounded one-shot procd service. `restart` sends SIGTERM/SIGKILL
# to an active first-boot enrollment; `start` preserves that attempt and lets
# the PID-aware lock discard a duplicate trigger.
/etc/init.d/headscale-auto-enroll start >/dev/null 2>&1 || true

exit 0
