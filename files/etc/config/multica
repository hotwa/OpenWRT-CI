config multica 'main'
	option enabled '0'
	option server_url 'https://multica.lucky.jmsu.top'
	option app_url 'https://multica.lucky.jmsu.top'
	option token ''
	option workspace_id ''
	option device_name 'OpenWrt-Router'
	option runtime_name 'Pi (OpenWrt-Router)'
	option runtime_provider 'pi'
	option agent_name 'OpenWrt 管家'
	option workspaces_root '/data/multica/workspaces'
	option max_concurrent_tasks '1'
	option poll_interval '30s'
	option heartbeat_interval '15s'
	# Signed runtime updates are checked nightly and upgraded only when a newer
	# compatible release is available. Set to 0 to keep the current generation.
	option auto_runtime_upgrade '1'
