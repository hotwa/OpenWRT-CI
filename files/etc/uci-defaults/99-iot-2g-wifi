#!/bin/sh
# RE-CS-02: the C1Pro plug only associated after disabling HT/HE in field tests.
set -eu

[ "$(cat "${RECS02_BOARD_FILE:-/tmp/sysinfo/board_name}" 2>/dev/null || true)" = jdcloud,re-cs-02 ] || exit 0
KEY_FILE="${RECS02_IOT_KEY_FILE:-/etc/re-cs-02/iot-wifi.key}"
[ -s "$KEY_FILE" ] || exit 0
key="$(cat "$KEY_FILE")"

if ! uci -q show wireless >/dev/null 2>&1; then
    wifi config >/dev/null 2>&1 || true
fi
changed=0
for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p'); do
    [ "$(uci -q get "wireless.$radio.band" || true)" = 2g ] || continue
    for option in ieee80211n ieee80211ax ieee80211d disabled; do
        uci set "wireless.$radio.$option=0"
    done
    # Delete the option: neither an empty value nor a literal NONE is intended.
    uci -q delete "wireless.$radio.htmode" || true
    uci -q delete "wireless.$radio.require_mode" || true
    uci set "wireless.$radio.legacy_rates=1"
    uci set "wireless.$radio.country=CN"
    uci set "wireless.$radio.channel=6"
    uci set "wireless.$radio.cell_density=0"
    for iface in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
        [ "$(uci -q get "wireless.$iface.device" || true)" = "$radio" ] || continue
        [ "$(uci -q get "wireless.$iface.mode" || true)" = ap ] || continue
        uci set "wireless.$iface.ssid=DAE-WRT-IoT"
        uci set "wireless.$iface.encryption=psk2+ccmp"
        uci set "wireless.$iface.key=$key"
        for option in ieee80211w uapsd disassoc_low_ack ieee80211r ieee80211k bss_transition disabled; do
            uci set "wireless.$iface.$option=0"
        done
    done
    changed=1
done
# Leave the one-shot hook for retry if netifd has not generated the radios yet.
[ "$changed" = 1 ] || exit 1
uci commit wireless
exit 0
