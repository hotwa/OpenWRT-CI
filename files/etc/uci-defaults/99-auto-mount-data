#!/bin/sh
# Mount the explicitly provisioned OpenWrt data partition and migrate mutable
# agent state. This script deliberately never formats or guesses a partition.

set -u

DATA_ROOT="${AUTO_MOUNT_DATA_ROOT:-/data}"
ROOT_HOME="${AUTO_MOUNT_ROOT_HOME:-/root}"
OPT_ROOT="${AUTO_MOUNT_OPT_ROOT:-/opt}"
MOUNTS_FILE="${AUTO_MOUNT_PROC_MOUNTS:-/proc/mounts}"
LOCK_BASE="${AUTO_MOUNT_LOCK_BASE:-/var/lock}"
LOCK_DIR="$LOCK_BASE/openwrt-data-mount.lock"
BLOCK_INFO_FIXTURE="${AUTO_MOUNT_BLOCK_INFO:-}"
FSTAB_RECORD="${AUTO_MOUNT_FSTAB_RECORD:-}"
TESTING="${AUTO_MOUNT_DATA_TESTING:-0}"
STORAGE_ENABLED_OVERRIDE="${AUTO_MOUNT_DATA_STORAGE_ENABLED:-}"
BOARD_FILE="${AUTO_MOUNT_DATA_BOARD_FILE:-/tmp/sysinfo/board_name}"
LEGACY_APPROVAL_FILE="${AUTO_MOUNT_LEGACY_APPROVAL_FILE:-/overlay/.emmc-data-provision.legacy-data-approved}"
PI_APPEND_SYSTEM_LINK_BIN="${AUTO_MOUNT_PI_APPEND_SYSTEM_LINK_BIN:-/usr/sbin/pi-append-system-link}"
COMMANDCODE_ROLE_LINK_BIN="${AUTO_MOUNT_COMMANDCODE_ROLE_LINK_BIN:-/usr/sbin/commandcode-role-link}"
OPENCODE_ROLE_LINK_BIN="${AUTO_MOUNT_OPENCODE_ROLE_LINK_BIN:-/usr/sbin/opencode-role-link}"
AGENT_TOOLS_LINK_BIN="${AUTO_MOUNT_AGENT_TOOLS_LINK_BIN:-/usr/sbin/agent-tools-link}"
FIRMWARE_ETC="${AUTO_MOUNT_FIRMWARE_ETC:-/etc}"

log_error() {
	printf '%s\n' "auto-mount-data: $*" >&2
	command -v logger >/dev/null 2>&1 && logger -t auto-mount-data -- "$*" || true
}

cleanup_lock() {
	rmdir "$LOCK_DIR" 2>/dev/null || true
}

acquire_lock() {
	mkdir -p "$LOCK_BASE" || return 1
	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		log_error "another storage migration is already running"
		return 1
	fi
	trap cleanup_lock EXIT
	trap 'cleanup_lock; exit 1' HUP INT TERM
}

block_inventory() {
	if [ -n "$BLOCK_INFO_FIXTURE" ]; then
		cat "$BLOCK_INFO_FIXTURE"
	else
		# block info is the normal OpenWrt source. util-linux blkid is also
		# consulted because some block versions omit GPT PARTUUID metadata.
		if command -v block >/dev/null 2>&1; then
			block info 2>/dev/null
		fi
		if command -v blkid >/dev/null 2>&1; then
			blkid 2>/dev/null
		fi
	fi
}

uci_get() {
	if [ "$TESTING" = "1" ]; then
		case "$1" in
			fstab.data.enabled) printf '%s' "${AUTO_MOUNT_TEST_FSTAB_ENABLED:-}" ;;
			fstab.data.uuid) printf '%s' "${AUTO_MOUNT_TEST_FSTAB_UUID:-}" ;;
			fstab.data.partuuid) printf '%s' "${AUTO_MOUNT_TEST_FSTAB_PARTUUID:-}" ;;
			fstab.data.label) printf '%s' "${AUTO_MOUNT_TEST_FSTAB_LABEL:-}" ;;
			*) return 1 ;;
		esac
		return 0
	fi
	command -v uci >/dev/null 2>&1 || return 1
	uci -q get "$1" 2>/dev/null
}

storage_mount_policy_enabled() {
	local value
	if [ -n "$STORAGE_ENABLED_OVERRIDE" ]; then
		value="$STORAGE_ENABLED_OVERRIDE"
	else
		value="$(uci_get agent-storage.main.enabled || true)"
	fi
	case "$value" in 1|true|yes|on) return 0 ;; *) return 1 ;; esac
}

reviewed_label_mount_board() {
	local board
	board="$(cat "$BOARD_FILE" 2>/dev/null || true)"
	supported_legacy_board "$board"
}

attribute_from_line() {
	local line="$1"
	local key="$2"
	printf '%s\n' "$line" | sed -n "s/.*[[:space:]]$key=\"\([^\"]*\)\".*/\1/p"
}

valid_identifier() {
	case "$1" in
		''|*[!A-Za-z0-9._:+-]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_number() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

supported_legacy_board() {
	case "$1" in
		jdcloud,re-ss-01|jdcloud,re-cs-02|jdcloud,re-cs-07) return 0 ;;
		*) return 1 ;;
	esac
}

find_devices() {
	local key="$1"
	local expected="$2"
	local line value

	block_inventory | while IFS= read -r line; do
		case "$line" in
			/dev/*:*) ;;
			*) continue ;;
		esac
		value="$(attribute_from_line "$line" "$key")"
		[ "$value" = "$expected" ] && printf '%s\n' "${line%%:*}"
	done | awk '!seen[$0]++'
}

# Find label-opted-in data partitions: an existing ext4/f2fs filesystem with
# any of PARTLABEL=data, PARTLABEL=openwrt-data, or LABEL=openwrt-data.
# These are factory- or provisioner-created data partitions (e.g. re-cs-02
# p27 PARTLABEL=data, re-ss-01 p27 PARTLABEL/LABEL=openwrt-data) that may
# be mounted directly by UUID without an approval file and without
# reformatting. System partitions are inherently excluded because their GPT
# names (rootfs/HLOS/swap/etc.) never match these opt-in labels.
find_label_opted_data_devices() {
	local line device partlabel label fstype
	block_inventory | while IFS= read -r line; do
		case "$line" in
			/dev/*:*) ;;
			*) continue ;;
		esac
		fstype="$(attribute_from_line "$line" TYPE)"
		case "$fstype" in ext4|f2fs) ;; *) continue ;; esac
		partlabel="$(attribute_from_line "$line" PARTLABEL)"
		label="$(attribute_from_line "$line" LABEL)"
		case "$partlabel" in
			data|openwrt-data) ;;
			*) [ "$label" = openwrt-data ] || continue ;;
		esac
		device="${line%%:*}"
		printf '%s\n' "$device"
	done | awk '!seen[$0]++'
}

device_line() {
	local expected="$1"
	local line
	block_inventory | while IFS= read -r line; do
		[ "${line%%:*}" = "$expected" ] && {
			printf '%s\n' "$line"
			break
		}
	done
}

select_legacy_data() {
	local board number device line partlabel fstype fs_uuid partuuid
	board="$(cat "$BOARD_FILE" 2>/dev/null || true)"
	supported_legacy_board "$board" || return 1
	number="$(legacy_approval_value number)"
	valid_number "$number" && [ "$number" -ge 1 ] || return 1
	device="/dev/mmcblk0p${number}"
	line="$(device_line "$device")"
	[ -n "$line" ] || return 1
	partlabel="$(attribute_from_line "$line" PARTLABEL)"
	[ "$partlabel" = data ] || return 1
	fstype="$(attribute_from_line "$line" TYPE)"
	case "$fstype" in ext4|f2fs) ;; *) return 1 ;; esac
	fs_uuid="$(attribute_from_line "$line" UUID)"
	valid_identifier "$fs_uuid" || return 1
	partuuid="$(attribute_from_line "$line" PARTUUID)"
	valid_identifier "$partuuid" || return 1
	legacy_data_is_approved "$number" "$fs_uuid" "$partuuid" "$fstype" || return 1

	# This is a one-time compatibility path for the exact approved tail data
	# partition. Its number is taken from the reviewed GPT approval record, not
	# guessed from a historical /dev/mmcblk0p27 convention.
	CANDIDATE_DEVICE="$device"
	CANDIDATE_FSTYPE="$fstype"
	CANDIDATE_UUID="$fs_uuid"
	log_error "adopting reviewed legacy data p${number} by filesystem UUID"
}

legacy_approval_value() {
	local key="$1"
	[ -f "$LEGACY_APPROVAL_FILE" ] || return 1
	sed -n "s/^${key}=//p" "$LEGACY_APPROVAL_FILE" | sed -n '1p'
}

legacy_data_is_approved() {
	local number="$1" uuid="$2" partuuid="$3" fstype="$4"
	local disk stored_number partlabel stored_uuid stored_partuuid stored_fstype
	[ -f "$LEGACY_APPROVAL_FILE" ] || return 1
	disk="$(legacy_approval_value disk)"
	stored_number="$(legacy_approval_value number)"
	partlabel="$(legacy_approval_value partlabel)"
	stored_uuid="$(legacy_approval_value uuid)"
	stored_partuuid="$(legacy_approval_value partuuid)"
	stored_fstype="$(legacy_approval_value fstype)"
	[ "$disk" = /dev/mmcblk0 ] && [ "$stored_number" = "$number" ] && \
		valid_number "$stored_number" && [ "$stored_number" -ge 1 ] && [ "$partlabel" = data ] || return 1
	valid_identifier "$stored_uuid" && valid_identifier "$stored_partuuid" || return 1
	[ "$stored_uuid" = "$uuid" ] && [ "$stored_partuuid" = "$partuuid" ] && \
		[ "$stored_fstype" = "$fstype" ]
}

select_candidate() {
	local requested_uuid requested_partuuid requested_label enabled
	local matches count device line fstype fs_uuid

	enabled="$(uci_get fstab.data.enabled || true)"
	if [ "$enabled" = "0" ]; then
		log_error "fstab.data is explicitly disabled"
		return 1
	fi

	requested_uuid="$(uci_get fstab.data.uuid || true)"
	requested_partuuid="$(uci_get fstab.data.partuuid || true)"
	requested_label="$(uci_get fstab.data.label || true)"

	if [ -n "$requested_uuid" ]; then
		valid_identifier "$requested_uuid" || {
			log_error "fstab.data.uuid contains invalid characters"
			return 1
		}
		matches="$(find_devices UUID "$requested_uuid")"
	elif [ -n "$requested_partuuid" ]; then
		valid_identifier "$requested_partuuid" || {
			log_error "fstab.data.partuuid contains invalid characters"
			return 1
		}
		matches="$(find_devices PARTUUID "$requested_partuuid")"
	else
		# A label is not consent on its own. Label lookup may run only after the
		# reviewed agent-storage gate has been explicitly enabled for a supported
		# provisioning workflow. Other images need an exact UUID/PARTUUID.
		storage_mount_policy_enabled || {
			log_error "no explicit UUID/PARTUUID and storage policy is disabled; refusing label-only mount"
			return 1
		}
		reviewed_label_mount_board || {
			log_error "no explicit UUID/PARTUUID and board is not approved for label-only mount"
			return 1
		}
		[ -z "$requested_label" ] || [ "$requested_label" = "openwrt-data" ] || {
			log_error "only LABEL=openwrt-data is accepted"
			return 1
		}
		# Enumerate all label-opted-in data partitions: ext4/f2fs with
		# PARTLABEL=data, PARTLABEL=openwrt-data, or LABEL=openwrt-data.
		# Exactly one candidate is required; multiple matches are ambiguous
		# and refused (count check below). Approval-file legacy fallback
		# (select_legacy_data) runs only when no label candidate exists.
		matches="$(find_label_opted_data_devices)" 
	fi

	count="$(printf '%s\n' "$matches" | awk 'NF { count++ } END { print count + 0 }')"
	if [ "$count" -eq 0 ] && [ -z "$requested_uuid" ] && \
		[ -z "$requested_partuuid" ] && [ -z "$requested_label" ]; then
		select_legacy_data && return 0
	fi
	if [ "$count" -ne 1 ]; then
		log_error "expected exactly one opted-in data partition, found $count"
		return 1
	fi

	device="$(printf '%s\n' "$matches" | awk 'NF { print; exit }')"
	case "$device" in
		/dev/*) ;;
		*) log_error "candidate is not a /dev path"; return 1 ;;
	esac
	if [ "$TESTING" != "1" ] && [ ! -b "$device" ]; then
		log_error "$device is not a block device"
		return 1
	fi

	line="$(device_line "$device")"
	fstype="$(attribute_from_line "$line" TYPE)"
	fs_uuid="$(attribute_from_line "$line" UUID)"
	case "$fstype" in
		ext4|f2fs) ;;
		*) log_error "$device has unsupported filesystem '$fstype'"; return 1 ;;
	esac
	valid_identifier "$fs_uuid" || {
		log_error "$device has no usable filesystem UUID"
		return 1
	}

	CANDIDATE_DEVICE="$device"
	CANDIDATE_FSTYPE="$fstype"
	CANDIDATE_UUID="$fs_uuid"
}

candidate_mount_targets() {
	awk -v expected="$CANDIDATE_DEVICE" '$1 == expected { print $2 }' "$MOUNTS_FILE" 2>/dev/null
}

detach_known_automount() {
	local targets count target expected
	targets="$(candidate_mount_targets)"
	count="$(printf '%s\n' "$targets" | awk 'NF { count++ } END { print count + 0 }')"
	[ "$count" -eq 0 ] && return 0
	expected="/mnt/${CANDIDATE_DEVICE##*/}"
	if [ "$count" -ne 1 ] || [ "$targets" != "$expected" ]; then
		log_error "$CANDIDATE_DEVICE is already mounted outside its known anonymous mountpoint; refusing to remount"
		return 1
	fi
	if [ "$TESTING" = "1" ]; then
		[ "${AUTO_MOUNT_TEST_UMOUNT_FAIL:-0}" != "1" ] || return 1
		awk -v source="$CANDIDATE_DEVICE" -v target="$expected" \
			'!($1 == source && $2 == target)' "$MOUNTS_FILE" >"$MOUNTS_FILE.new.$$" || return 1
		mv "$MOUNTS_FILE.new.$$" "$MOUNTS_FILE" || return 1
		return 0
	fi
	umount "$expected"
}

mounted_source() {
	awk -v target="$DATA_ROOT" '$2 == target { print $1; exit }' "$MOUNTS_FILE" 2>/dev/null
}

source_matches_candidate() {
	local source="$1"
	local line uuid
	[ "$source" = "$CANDIDATE_DEVICE" ] && return 0
	[ "$source" = "UUID=$CANDIDATE_UUID" ] && return 0
	case "$source" in
		*/by-uuid/"$CANDIDATE_UUID") return 0 ;;
	esac
	line="$(device_line "$source")"
	uuid="$(attribute_from_line "$line" UUID)"
	[ -n "$uuid" ] && [ "$uuid" = "$CANDIDATE_UUID" ]
}

mount_candidate() {
	mkdir -p "$DATA_ROOT" || return 1
	detach_known_automount || return 1
	if [ "$TESTING" = "1" ]; then
		[ "${AUTO_MOUNT_TEST_MOUNT_FAIL:-0}" != "1" ] || return 1
		printf '%s %s %s rw,noatime 0 0\n' \
			"$CANDIDATE_DEVICE" "$DATA_ROOT" "$CANDIDATE_FSTYPE" >>"$MOUNTS_FILE"
		return 0
	fi
	mount -t "$CANDIDATE_FSTYPE" -o rw,noatime "$CANDIDATE_DEVICE" "$DATA_ROOT"
}

verify_mounted_storage() {
	local source probe
	source="$(mounted_source)"
	[ -n "$source" ] || {
		log_error "$DATA_ROOT is not a real mountpoint"
		return 1
	}
	source_matches_candidate "$source" || {
		log_error "$DATA_ROOT is mounted from an unexpected source: $source"
		return 1
	}
	probe="$DATA_ROOT/.openwrt-data-write-probe.$$"
	( umask 077; : >"$probe" ) 2>/dev/null || {
		log_error "$DATA_ROOT failed its write probe"
		return 1
	}
	rm -f "$probe" || return 1
}

persist_fstab() {
	if [ "$TESTING" = "1" ]; then
		[ -n "$FSTAB_RECORD" ] || return 0
		printf 'target=%s\nuuid=%s\nfstype=%s\noptions=rw,noatime\nenabled=1\n' \
			"$DATA_ROOT" "$CANDIDATE_UUID" "$CANDIDATE_FSTYPE" >"$FSTAB_RECORD"
		return $?
	fi
	command -v uci >/dev/null 2>&1 || {
		log_error "uci is unavailable; refusing a non-persistent data mount"
		return 1
	}
	uci -q set fstab.data=mount || return 1
	uci -q set fstab.data.target='/data' || return 1
	uci -q set "fstab.data.uuid=$CANDIDATE_UUID" || return 1
	uci -q set "fstab.data.fstype=$CANDIDATE_FSTYPE" || return 1
	uci -q set fstab.data.options='rw,noatime' || return 1
	uci -q set fstab.data.enabled='1' || return 1
	uci -q delete fstab.data.device 2>/dev/null || true
	uci -q delete fstab.data.partuuid 2>/dev/null || true
	uci -q delete fstab.data.label 2>/dev/null || true
	uci -q commit fstab || return 1
}

ensure_real_directory() {
	[ ! -L "$1" ] || {
		log_error "refusing symlinked data directory: $1"
		return 1
	}
	mkdir -p "$1" || return 1
	[ -d "$1" ] || return 1
	chmod 0700 "$1" 2>/dev/null || true
}

verify_tree() {
	local source="$1"
	local destination="$2"
	(
		cd "$source" || exit 1
		find . -mindepth 1 -print
	) | while IFS= read -r relative; do
		local src="$source/$relative"
		local dst="$destination/$relative"
		if [ -L "$src" ]; then
			[ -L "$dst" ] && [ "$(readlink "$src")" = "$(readlink "$dst")" ] || exit 1
		elif [ -d "$src" ]; then
			[ -d "$dst" ] && [ ! -L "$dst" ] || exit 1
		elif [ -f "$src" ]; then
			[ -f "$dst" ] && cmp -s "$src" "$dst" || exit 1
		else
			log_error "unsupported object during migration: $src"
			exit 1
		fi
	done
}

copy_tree_verified() {
	local source="$1"
	local target="$2"
	local stage="$DATA_ROOT/.migration-stage.$$.${3}"

	ensure_real_directory "$stage" || return 1
	if [ "$TESTING" = "1" ] && [ "${AUTO_MOUNT_TEST_COPY_FAIL:-0}" = "1" ]; then
		rm -rf "$stage"
		return 1
	fi
	cp -a "$source/." "$stage/" || {
		rm -rf "$stage"
		return 1
	}
	verify_tree "$source" "$stage" || {
		rm -rf "$stage"
		return 1
	}
	cp -a "$stage/." "$target/" || {
		rm -rf "$stage"
		return 1
	}
	verify_tree "$source" "$target" || {
		rm -rf "$stage"
		return 1
	}
	rm -rf "$stage"
}

link_directory() {
	local target="$1"
	local link_path="$2"
	local name="$3"
	local temporary="${link_path}.new.$$"
	local backup="${link_path}.migration-backup.$$"

	ensure_real_directory "$target" || return 1
	if [ -L "$link_path" ]; then
		[ "$(readlink "$link_path")" = "$target" ] || {
			log_error "refusing to replace unexpected symlink: $link_path"
			return 1
		}
		return 0
	fi
	if [ -e "$link_path" ]; then
		[ -d "$link_path" ] || {
			log_error "refusing to replace non-directory: $link_path"
			return 1
		}
		copy_tree_verified "$link_path" "$target" "$name" || {
			log_error "verified copy failed; source preserved: $link_path"
			return 1
		}
		ln -s "$target" "$temporary" || return 1
		mv "$link_path" "$backup" || { rm -f "$temporary"; return 1; }
		if ! mv "$temporary" "$link_path" || [ ! -L "$link_path" ] || \
		   [ "$(readlink "$link_path")" != "$target" ]; then
			rm -f "$temporary" "$link_path" 2>/dev/null || true
			mv "$backup" "$link_path" 2>/dev/null || true
			return 1
		fi
		rm -rf "$backup" || return 1
		return 0
	fi

	ln -s "$target" "$temporary" || return 1
	mv "$temporary" "$link_path" || { rm -f "$temporary"; return 1; }
}

# These are convenience paths only. /data remains the real mountpoint because
# /opt contains immutable Node and agent-runtime baselines that must never be
# hidden by a data-disk mount. Do not replace a pre-existing user path.
link_compatibility_path() {
	local target="$1"
	local link_path="$2"
	local temporary="${link_path}.new.$$"

	[ -d "$target" ] && [ ! -L "$target" ] || return 1
	if [ -L "$link_path" ]; then
		[ "$(readlink "$link_path")" = "$target" ]
		return
	fi
	[ ! -e "$link_path" ] || {
		log_error "leaving existing compatibility path unchanged: $link_path"
		return 0
	}
	mkdir -p "$(dirname "$link_path")" || return 1
	ln -s "$target" "$temporary" || return 1
	mv "$temporary" "$link_path" || { rm -f "$temporary"; return 1; }
}

# Detect whether the operator has manually edited /data/pi/agent/settings.json
# since the firmware last wrote it.  A managed marker carries the mtime of the
# last firmware write; a mismatch means the operator changed the file and we
# must not overwrite their customization.
settings_is_firmware_managed() {
	local marker="$DATA_ROOT/pi/agent/.firmware-settings-managed"
	[ -f "$marker" ] || return 1
	[ "$(stat -c %Y "$DATA_ROOT/pi/agent/settings.json" 2>/dev/null || true)" = \
	  "$(stat -c %Y "$marker" 2>/dev/null || true)" ]
}

mark_settings_firmware_managed() {
	touch -r "$DATA_ROOT/pi/agent/settings.json" \
		"$DATA_ROOT/pi/agent/.firmware-settings-managed" 2>/dev/null || \
		touch "$DATA_ROOT/pi/agent/.firmware-settings-managed"
}

# Select the preferred default model from a CommandCode model catalog cache.
# The cache is the raw /provider/v1/models response: {"data":[{"id":"..."},...]}.
# Uses only grep/sed/tr (no jq) because jq is not guaranteed on OpenWrt.
# Matching passes, in priority order (all case-insensitive):
#   1. deepseek flash   (deepseek/*flash*)
#   2. qwen flash       (qwen/*flash*)
#   3. glm flash        (*glm*flash*)
#   4. any flash model  (any provider, e.g. stepfun/Step-3.7-Flash)
#   5. any "pro" model  (e.g. deepseek/deepseek-v4-pro, xiaomi/mimo-v2.5-pro)
# No built-in fallback: the live catalog always contains a flash model.
# Returns 0 with the model id on stdout; returns 1 if the cache is missing,
# unparseable, or no pattern matches (caller decides how to handle).
# Keep this logic in sync with CommandCodeProviderConfig.sh select_preferred_model()
# and commandcode-model-sync select_model_from_cache().
select_model_from_cache() {
	local cache_file="$1"
	local model_ids model lower
	[ -f "$cache_file" ] || return 1
	model_ids="$(grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' "$cache_file" 2>/dev/null | \
		sed 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
	[ -n "$model_ids" ] || return 1

	# Pass 1: deepseek flash.
	for model in $model_ids; do
		lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
		case "$lower" in
			deepseek/*flash*) printf '%s\n' "$model"; return 0 ;;
		esac
	done
	# Pass 2: qwen flash.
	for model in $model_ids; do
		lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
		case "$lower" in
			qwen/*flash*) printf '%s\n' "$model"; return 0 ;;
		esac
	done
	# Pass 3: glm flash (matches z-ai/glm-*-flash and glm/*-flash).
	for model in $model_ids; do
		lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
		case "$lower" in
			*glm*flash*) printf '%s\n' "$model"; return 0 ;;
		esac
	done
	# Pass 4: any model with "flash" in the id (any provider).
	for model in $model_ids; do
		lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
		case "$lower" in
			*flash*) printf '%s\n' "$model"; return 0 ;;
		esac
	done
	# Pass 5: any model with "pro" in the id.
	for model in $model_ids; do
		lower="$(printf '%s' "$model" | tr '[:upper:]' '[:lower:]')"
		case "$lower" in
			*pro*) printf '%s\n' "$model"; return 0 ;;
		esac
	done
	# No match: caller decides.
	return 1
}

# Ensure /data/pi/agent/settings.json defaultModel matches the cached catalog.
# Only runs when the settings file is firmware-managed (not operator-edited).
# This makes the first-boot default model track the build-time cache selection
# and any runtime cache refresh performed by commandcode-model-sync.
ensure_default_model_from_cache() {
	local cache_file="$DATA_ROOT/pi/agent/commandcode-models.json"
	local settings_file="$DATA_ROOT/pi/agent/settings.json"
	local selected current

	[ -f "$settings_file" ] || return 0
	settings_is_firmware_managed || return 0
	[ -f "$cache_file" ] || return 0

	selected="$(select_model_from_cache "$cache_file")" || return 0
	[ -n "$selected" ] || return 0

	current="$(sed -n 's/.*"defaultModel"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$settings_file" | head -1)"
	[ "$selected" = "$current" ] && return 0

	sed -i "s|\"defaultModel\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"defaultModel\": \"$selected\"|" "$settings_file" || return 0
	mark_settings_firmware_managed
	log_error "defaultModel set to $selected from model catalog cache"
}

# One-time migration for devices that already have /data/pi/agent/settings.json
# from an older firmware.  If the build injected a CommandCode API key and the
# existing settings are still the firmware default (not operator-customized),
# flip defaultProvider to commandcode so the device picks up the zero-config
# provider without manual intervention.  The original file is backed up.
migrate_commandcode_provider() {
	local firmware_auth="$FIRMWARE_ETC/pi/agent/auth.json"
	local firmware_cache="$FIRMWARE_ETC/pi/agent/commandcode-models.json"
	local data_settings="$DATA_ROOT/pi/agent/settings.json"
	local data_auth="$DATA_ROOT/pi/agent/auth.json"
	local current_provider selected_model backup

	# Only migrate when the build actually injected a CommandCode key.
	[ -s "$firmware_auth" ] || return 0
	# Existing settings file must be present (this is the upgrade case).
	[ -f "$data_settings" ] || return 0
	# If the operator already configured CommandCode auth on /data, respect it.
	[ ! -s "$data_auth" ] || return 0

	current_provider="$(sed -n 's/.*"defaultProvider"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$data_settings" | head -1)"
	[ "$current_provider" != "commandcode" ] || return 0

	# Refuse to overwrite operator-customized settings.
	# - If a managed marker exists, a matching mtime proves the firmware wrote
	#   the file; a mismatch means the operator edited it afterward, so skip.
	# - If no marker exists (legacy device), use a conservative heuristic: only
	#   migrate when the provider is a known firmware default.
	if [ -f "$DATA_ROOT/pi/agent/.firmware-settings-managed" ]; then
		settings_is_firmware_managed || return 0
	else
		case "$current_provider" in
			office-sglang|cloudcollector|openai|anthropic) ;;
			*) return 0 ;;
		esac
	fi

	# Select the default model from the build-time cached catalog.  If the cache
	# is missing or unparseable, fall back to the stable Qwen/Qwen3.8-Flash.
	selected_model="$(select_model_from_cache "$firmware_cache" 2>/dev/null || true)"
	[ -n "$selected_model" ] || selected_model="Qwen/Qwen3.8-Flash"

	backup="$data_settings.bak.$(date +%Y%m%d%H%M%S 2>/dev/null || echo migration)"
	cp -p "$data_settings" "$backup" || return 1
	sed -i 's/"defaultProvider"[[:space:]]*:[[:space:]]*"[^"]*"/"defaultProvider": "commandcode"/' "$data_settings" || {
		mv "$backup" "$data_settings"
		return 1
	}
	sed -i "s|\"defaultModel\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"defaultModel\": \"$selected_model\"|" "$data_settings" || {
		mv "$backup" "$data_settings"
		return 1
	}
	# Carry the build-injected auth.json onto /data so Pi finds it at runtime.
	if [ ! -e "$data_auth" ]; then
		( umask 077; cp -p "$firmware_auth" "$data_auth.new" ) || return 1
		mv "$data_auth.new" "$data_auth" || return 1
	fi
	mark_settings_firmware_managed
	log_error "migrated existing Pi settings to CommandCode provider (model: $selected_model, backup: $backup)"
}

# Pi 0.85+ resolves "npm:pi-commandcode-provider" against
# /data/pi/agent/npm/node_modules.  The extension ships inside the agent-runtime
# node_modules tree, whose exact path can shift between runtime generations.
# Resolve it dynamically and create a stable symlink so Pi loads the provider
# without an explicit --extension flag.
ensure_commandcode_npm_link() {
	local npm_modules="$DATA_ROOT/pi/agent/npm/node_modules"
	local link_path="$npm_modules/pi-commandcode-provider"
	local search_root="${COMMANDCODE_PROVIDER_SEARCH_ROOT:-$DATA_ROOT/agent-runtime}"
	local provider_dir

	[ -d "$search_root" ] || return 0
	provider_dir="$(find "$search_root" -name "pi-commandcode-provider" -type d 2>/dev/null | head -1)"
	[ -n "$provider_dir" ] || return 0

	mkdir -p "$npm_modules" || return 1
	# ln -sfn is idempotent: it replaces an existing link without following it.
	ln -sfn "$provider_dir" "$link_path" || return 1
	log_error "linked pi-commandcode-provider to $provider_dir"
}

# Best-effort pre-warming of the CommandCode model catalog cache.  The
# extension normally fetches https://api.commandcode.ai/provider/v1/models on
# first use; if the network is not ready at boot the models may be temporarily
# unavailable.  Try once here; failure is non-fatal and the extension retries.
provision_commandcode_model_cache() {
	local cache_file="$DATA_ROOT/pi/agent/commandcode-models.json"
	local auth_file="$DATA_ROOT/commandcode/auth.json"
	local api_key fetch_cmd

	[ ! -e "$cache_file" ] || return 0
	[ -s "$auth_file" ] || return 0

	api_key="$(sed -n 's/.*"apiKey"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$auth_file" | head -1)"
	[ -n "$api_key" ] || return 0

	for fetch_cmd in uclient-fetch curl wget; do
		command -v "$fetch_cmd" >/dev/null 2>&1 || continue
		case "$fetch_cmd" in
			uclient-fetch)
				uclient-fetch -q -T 15 -O "$cache_file" \
					--header="Authorization: Bearer $api_key" \
					"https://api.commandcode.ai/provider/v1/models" 2>/dev/null || true
				;;
			curl)
				curl -sf --max-time 15 \
					-H "Authorization: Bearer $api_key" \
					-o "$cache_file" \
					"https://api.commandcode.ai/provider/v1/models" 2>/dev/null || true
				;;
			wget)
				wget -qO "$cache_file" --timeout=15 \
					--header="Authorization: Bearer $api_key" \
					"https://api.commandcode.ai/provider/v1/models" 2>/dev/null || true
				;;
		esac
		if [ -s "$cache_file" ]; then
			log_error "pre-warmed CommandCode model catalog cache"
			return 0
		fi
	done
	# Non-fatal: the extension will fetch the catalog when it first loads.
	rm -f "$cache_file"
	log_error "CommandCode model cache pre-warm skipped (network unavailable); extension will fetch on first use"
	return 0
}

prepare_agent_storage() {
	local directory
	for directory in \
		"$DATA_ROOT/multica" \
		"$DATA_ROOT/multica/workspaces" \
		"$DATA_ROOT/agent_workspaces" \
		"$DATA_ROOT/pi" \
		"$DATA_ROOT/pi/agent" \
		"$DATA_ROOT/pi/agent/secrets" \
		"$DATA_ROOT/commandcode" \
		"$DATA_ROOT/uv" \
		"$DATA_ROOT/uv/cache" \
		"$DATA_ROOT/uv/python" \
		"$DATA_ROOT/pnpm" \
		"$DATA_ROOT/npm" \
		"$DATA_ROOT/cache" \
		"$DATA_ROOT/compose" \
		"$DATA_ROOT/smb"; do
		ensure_real_directory "$directory" || return 1
	done
	chmod 0750 "$DATA_ROOT/smb" 2>/dev/null || true

	# Upgrade devices that already have /data/pi/agent/settings.json from an
	# older firmware: if the build injected a CommandCode key and the existing
	# settings are still firmware-default, flip defaultProvider to commandcode.
	# This must run BEFORE the copy loop below so that a freshly copied auth.json
	# does not make the migration think the operator already configured CommandCode.
	migrate_commandcode_provider || return 1

	if [ -f "$FIRMWARE_ETC/multica/openwrt-agent.md" ]; then
		cp -p "$FIRMWARE_ETC/multica/openwrt-agent.md" "$DATA_ROOT/multica/openwrt-agent.md.new" || return 1
		cmp -s "$FIRMWARE_ETC/multica/openwrt-agent.md" "$DATA_ROOT/multica/openwrt-agent.md.new" || return 1
		mv "$DATA_ROOT/multica/openwrt-agent.md.new" "$DATA_ROOT/multica/openwrt-agent.md" || return 1
	fi
	for config_file in models.json settings.json auth.json commandcode-models.json; do
		[ -r "$FIRMWARE_ETC/pi/agent/$config_file" ] || continue
		[ ! -e "$DATA_ROOT/pi/agent/$config_file" ] || continue
		cp -p "$FIRMWARE_ETC/pi/agent/$config_file" "$DATA_ROOT/pi/agent/$config_file.new" || return 1
		mv "$DATA_ROOT/pi/agent/$config_file.new" "$DATA_ROOT/pi/agent/$config_file" || return 1
		if [ "$config_file" = "settings.json" ]; then
			mark_settings_firmware_managed
		fi
	done

	# After a fresh first-boot copy of settings.json, ensure defaultModel tracks
	# the cached model catalog (the firmware settings may carry a model selected
	# from the build-time fallback cache).  This is a no-op on upgrades where the
	# operator already customized settings.
	ensure_default_model_from_cache || true

	# CommandCode CLI auth: sync the build-injected key onto /data so the
	# cmd / cmdc CLI finds it at ~/.commandcode/auth.json.  pi-commandcode-provider
	# reads the same file in addition to ~/.pi/agent/auth.json.
	# A stale key left behind by an earlier manual /login (or an older build)
	# shadows the firmware key through the provider's auth-path priority and
	# yields 401 Unauthorized once that key expires.  When the existing file
	# differs from the firmware key, prefer the firmware key and keep a
	# timestamped backup of the previous one so the operator can recover a
	# newer manually logged-in credential if it is still valid.
	if [ -r "$FIRMWARE_ETC/commandcode/auth.json" ]; then
		if [ ! -e "$DATA_ROOT/commandcode/auth.json" ] || \
		   ! cmp -s "$FIRMWARE_ETC/commandcode/auth.json" "$DATA_ROOT/commandcode/auth.json"; then
			if [ -e "$DATA_ROOT/commandcode/auth.json" ]; then
				( umask 077; cp -p "$DATA_ROOT/commandcode/auth.json" \
					"$DATA_ROOT/commandcode/auth.json.bak.$(date +%Y%m%d%H%M%S)" ) 2>/dev/null || true
			fi
			( umask 077; cp -p "$FIRMWARE_ETC/commandcode/auth.json" "$DATA_ROOT/commandcode/auth.json.new" ) || return 1
			mv "$DATA_ROOT/commandcode/auth.json.new" "$DATA_ROOT/commandcode/auth.json" || return 1
		fi
	fi

	# Pi loads "npm:pi-commandcode-provider" from /data/pi/agent/npm/node_modules.
	# Link it to the extension inside the agent-runtime tree (resolved dynamically).
	ensure_commandcode_npm_link || return 1

	# Best-effort pre-warm of the model catalog cache so CommandCode models are
	# available even if the network was not ready at first boot.
	provision_commandcode_model_cache

	# pi-subagents resolves schedule roots against the real project path.
	# /root/.pi is a symlink to /data/pi, so a "~/"-based store root trips its
	# trust check ("resolves outside the real project"). Seed an absolute
	# storeRoot once, unless the operator has already configured the extension.
	subagent_cfg_dir="$DATA_ROOT/pi/agent/extensions/subagent"
	if [ ! -e "$subagent_cfg_dir/config.json" ]; then
		ensure_real_directory "$subagent_cfg_dir" || return 1
		printf '%s\n' '{"scheduledRuns":{"storeRoot":"/data/pi/subagents/schedules"}}' \
			> "$subagent_cfg_dir/config.json.new" || return 1
		mv "$subagent_cfg_dir/config.json.new" "$subagent_cfg_dir/config.json" || return 1
	fi

	# cloudcollector API key placeholder. An empty file keeps the path stable
	# so Pi/CommandCode can reference it without a missing-file error; the real
	# key is injected at build time or by the operator.
	if [ ! -e "$DATA_ROOT/pi/agent/secrets/cloudcollector-api-key" ]; then
		( umask 077; : >"$DATA_ROOT/pi/agent/secrets/cloudcollector-api-key" ) || return 1
	fi

	[ -d "$ROOT_HOME" ] || return 0
	link_directory "$DATA_ROOT/multica" "$ROOT_HOME/.multica" multica || return 1
	link_directory "$DATA_ROOT/multica/workspaces" "$ROOT_HOME/multica-workspaces" multica-workspaces || return 1
	link_directory "$DATA_ROOT/pi" "$ROOT_HOME/.pi" pi || return 1
	link_directory "$DATA_ROOT/commandcode" "$ROOT_HOME/.commandcode" commandcode || return 1
	# CommandCode reads its user-level AGENTS.md on each request. Bind it to
	# the same rendered role card Pi uses; an existing regular file is kept.
	if [ -x "$COMMANDCODE_ROLE_LINK_BIN" ]; then
		COMMANDCODE_HOME="$DATA_ROOT/commandcode" COMMANDCODE_ROLE_CARD="$DATA_ROOT/multica/openwrt-agent.md" \
			"$COMMANDCODE_ROLE_LINK_BIN" || return 1
	fi
	# opencode reads a user-level AGENTS.md (global rules) next to its config.
	# Bind it to the same rendered role card; a missing config dir (device
	# without opencode, e.g. re-ss-01) is a silent no-op inside the script.
	if [ -x "$OPENCODE_ROLE_LINK_BIN" ]; then
		OPENCODE_CONFIG_DIR="$DATA_ROOT/opencode/config" OPENCODE_ROLE_CARD="$DATA_ROOT/multica/openwrt-agent.md" \
			"$OPENCODE_ROLE_LINK_BIN" || return 1
	fi
	if [ -x "$AGENT_TOOLS_LINK_BIN" ]; then
		AGENT_TOOLS_ROOT="$DATA_ROOT/shared/agent-tools" \
		PI_SKILLS_DIR="$DATA_ROOT/pi/agent/skills" \
		COMMANDCODE_SKILLS_DIR="$DATA_ROOT/commandcode/skills" \
			"$AGENT_TOOLS_LINK_BIN" || return 1
	fi
	# Pi appends this link after its built-in tool prompt. Point it at the
	# dynamically rendered Multica role card rather than copying a second card,
	# so interactive Pi and daemon-dispatched sessions share one source.
	if [ -x "$PI_APPEND_SYSTEM_LINK_BIN" ]; then
		PI_AGENT_DIR="$DATA_ROOT/pi/agent" PI_ROLE_CARD="$ROOT_HOME/.multica/openwrt-agent.md" \
			"$PI_APPEND_SYSTEM_LINK_BIN" || return 1
	fi
	link_compatibility_path "$DATA_ROOT" "$OPT_ROOT/data" || \
		log_error "could not create optional compatibility path: $OPT_ROOT/data"
	link_compatibility_path "$DATA_ROOT/smb" "$OPT_ROOT/smb" || \
		log_error "could not create optional compatibility path: $OPT_ROOT/smb"
	# Enable future boot retries, then provision immediately so a newly flashed
	# router with a ready /data mount has python3 before Multica starts.
	if [ -x /etc/init.d/uv-runtime ]; then
		/etc/init.d/uv-runtime enable || log_error "could not enable uv-runtime"
	fi
	if [ -x /usr/sbin/uv-runtime-provision ]; then
		UV_RUNTIME_QUIET=1 /usr/sbin/uv-runtime-provision || \
			log_error "offline Python provisioning deferred"
	fi
	# Enable the CommandCode model catalog sync service.  It runs in the
	# background after boot (START=99) and refreshes the cached model list plus
	# defaultModel once the network is available.  Best-effort only.
	if [ -x /etc/init.d/commandcode-model-sync ]; then
		/etc/init.d/commandcode-model-sync enable >/dev/null 2>&1 || \
			log_error "could not enable commandcode-model-sync"
	fi
}

main() {
	local source
	acquire_lock || return 1
	select_candidate || return 1
	source="$(mounted_source)"
	if [ -n "$source" ]; then
		source_matches_candidate "$source" || {
			log_error "$DATA_ROOT is already mounted from an unapproved source: $source"
			return 1
		}
	else
		mount_candidate || {
			log_error "failed to mount the opted-in data partition"
			return 1
		}
	fi
	verify_mounted_storage || return 1
	persist_fstab || return 1
	prepare_agent_storage || return 1
}

main
