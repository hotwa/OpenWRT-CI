#!/bin/sh
# Auto-discover the largest unmounted eMMC/storage partition and mount as /data
# Creates workspace directories for Multica, OpenCode, Pi, and AI agents.

set -e

mkdir -p /data

# 1. Look for recognized data partition or largest partition on mmcblk0, nvme0n1, or sda (size > 1GB)
CANDIDATE=""
if command -v lsblk >/dev/null 2>&1; then
	CANDIDATE=$(lsblk -bno NAME,SIZE,TYPE,MOUNTPOINT,FSTYPE 2>/dev/null | awk '
		$3 == "part" && $4 == "" && $2 > 1073741824 && ($5 ~ /^(f2fs|ext4|ext3|btrfs|xfs)$/) && ($1 ~ /^mmcblk/ || $1 ~ /^nvme/ || $1 ~ /^sd/) {
			print $2, $1
		}
	' | sort -n | tail -1 | awk '{print $2}')
fi

# Fallback to block info for labeled partition (data, userdata, openwrt-data)
if [ -z "$CANDIDATE" ] && command -v block >/dev/null 2>&1; then
	DATA_DEV=$(block info 2>/dev/null | grep -iE 'LABEL="(data|userdata|openwrt-data)"' | cut -d: -f1 | head -1)
	if [ -n "$DATA_DEV" ]; then
		CANDIDATE=$(basename "$DATA_DEV")
	fi
fi

if [ -n "$CANDIDATE" ] && [ -b "/dev/$CANDIDATE" ]; then
	DEV_PATH="/dev/$CANDIDATE"

	# Check if already mounted
	if ! grep -q "$DEV_PATH" /proc/mounts 2>/dev/null && ! grep -q " /data " /proc/mounts 2>/dev/null; then
		FSTYPE=""
		if command -v blkid >/dev/null 2>&1; then
			FSTYPE=$(blkid -s TYPE -o value "$DEV_PATH" 2>/dev/null || true)
		fi

		# Only mount if a valid filesystem exists; never blind-format
		if [ -n "$FSTYPE" ]; then
			if command -v uci >/dev/null 2>&1; then
				if ! uci show fstab 2>/dev/null | grep -q "'/data'"; then
					uci add fstab mount >/dev/null 2>&1 || true
					uci set fstab.@mount[-1].target='/data'
					uci set fstab.@mount[-1].device="$DEV_PATH"
					uci set fstab.@mount[-1].enabled='1'
					uci set fstab.@mount[-1].options='rw,noatime'
					uci set fstab.@mount[-1].fstype="$FSTYPE"
					uci commit fstab >/dev/null 2>&1 || true
				fi
			fi

			mount -o rw,noatime "$DEV_PATH" /data 2>/dev/null || mount "$DEV_PATH" /data 2>/dev/null || true
		fi
	fi
fi

# 2. Setup standard directory layout and guaranteed symlinks on /data
mkdir -p /data/multica/workspaces
mkdir -p /data/agent_workspaces
mkdir -p /data/pi
mkdir -p /data/opencode
mkdir -p /data/pnpm
mkdir -p /data/uv_cache

# Ensure /etc/multica/openwrt-agent.md is copied to /data/multica/
if [ -f /etc/multica/openwrt-agent.md ] && [ ! -f /data/multica/openwrt-agent.md ]; then
	cp /etc/multica/openwrt-agent.md /data/multica/openwrt-agent.md 2>/dev/null || true
fi

link_directory() {
	local target="$1"
	local link_path="$2"

	mkdir -p "$target"
	if [ -e "$link_path" ] && [ ! -L "$link_path" ]; then
		cp -an "$link_path"/* "$target"/ 2>/dev/null || true
		rm -rf "$link_path"
	fi
	[ -L "$link_path" ] || ln -sfn "$target" "$link_path" 2>/dev/null || true
}

if [ -d /root ]; then
	link_directory /data/multica /root/.multica
	link_directory /data/multica/workspaces /root/multica-workspaces
	link_directory /data/pi /root/.pi
	link_directory /data/opencode /root/.opencode
fi

# UV Cache global redirection
mkdir -p /opt
[ -L /opt/uv ] || ln -sfn /data/uv_cache /opt/uv 2>/dev/null || true

exit 0