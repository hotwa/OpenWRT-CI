#!/bin/sh /etc/rc.common
# wg-path-daemon — 开机自启智能路径守护
START=98
STOP=02
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/wg-path-daemon start
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/sbin/wg-path-daemon stop 2>/dev/null
}
