#!/bin/sh /etc/rc.common
START=98
STOP=02
USE_PROCD=1
start_service() {
    [ -s /etc/wg-site/site.conf ] || return 0
    /usr/sbin/wg-site-init || return 1
    procd_open_instance
    procd_set_param command /usr/sbin/wg-path-daemon start
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() { /usr/sbin/wg-path-daemon stop; }
