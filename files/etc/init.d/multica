#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONFIG="multica"
SECTION="main"
DEFAULT_PROG="/usr/local/bin/multica"
MAX_TASKS_LIMIT=4
RUNTIME_ENV="/tmp/uv-env.sh"

cfg() {
	local name="$1"
	local default="$2"
	local value
	value="$(uci -q get "$CONFIG.$SECTION.$name" 2>/dev/null || true)"
	[ -n "$value" ] || value="$default"
	printf '%s' "$value"
}

log_error() {
	logger -t multica "$*"
}

derive_device_name() {
	local explicit="$1"
	local hostname lan_ip site

	if [ -n "$explicit" ]; then
		printf '%s' "$explicit" | tr -cs 'A-Za-z0-9_.-' '-'
		return 0
	fi

	hostname="$(uci -q get system.@system[0].hostname 2>/dev/null || true)"
	[ -n "$hostname" ] || hostname="openwrt"
	lan_ip="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
	site=""
	case "$lan_ip" in
		192.168.*.*)
			site="${lan_ip#192.168.}"
			site="${site%%.*}"
			;;
	esac

	if [ -n "$site" ]; then
		printf '%s-%s' "$hostname" "$site" | tr -cs 'A-Za-z0-9_.-' '-'
	else
		printf '%s' "$hostname" | tr -cs 'A-Za-z0-9_.-' '-'
	fi
}

resolve_program() {
	local candidate
	for candidate in "$DEFAULT_PROG" /usr/bin/multica; do
		if [ -f "$candidate" ] && [ -x "$candidate" ]; then
			printf '%s' "$candidate"
			return 0
		fi
	done
	candidate="$(command -v multica 2>/dev/null || true)"
	[ -n "$candidate" ] && [ -f "$candidate" ] && [ -x "$candidate" ] || return 1
	printf '%s' "$candidate"
}

has_control_character() {
	LC_ALL=C printf '%s' "$1" | grep -q '[[:cntrl:]]'
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

valid_duration() {
	printf '%s' "$1" | grep -Eq '^[1-9][0-9]*(ms|s|m|h)$'
}

runtime_env_value() {
	local key="$1"
	local values count value
	values="$(sed -n "s/^export ${key}=//p" "$RUNTIME_ENV")"
	count="$(printf '%s\n' "$values" | sed '/^$/d' | wc -l)"
	[ "$count" -eq 1 ] || return 1
	value="$(printf '%s\n' "$values" | sed -n '1p')"
	case "$value" in
		/data/*) ;;
		*) return 1 ;;
	esac
	has_control_character "$value" && return 1
	printf '%s' "$value"
}

start_service() {
	local enabled token workspace_id server_url app_url
	local device_name runtime_name runtime_provider workspaces_root
	local max_tasks poll_interval heartbeat_interval prog config_dir config_json config_tmp
	local runtime_env_mode uv_cache_dir uv_python_install_dir uv_python_cache_dir
	local pnpm_store_dir npm_config_cache xdg_cache_home

	enabled="$(cfg enabled 0)"
	case "$enabled" in
		1|true|yes|on) ;;
		*) return 0 ;;
	esac

	prog="$(resolve_program)" || {
		log_error "Multica is enabled but no executable binary was found"
		return 1
	}

	token="$(cfg token '')"
	[ -n "$token" ] || {
		log_error "Multica is enabled but its token is not configured"
		return 1
	}
	workspace_id="$(cfg workspace_id '')"
	[ -n "$workspace_id" ] || {
		log_error "Multica is enabled but workspace_id is not configured"
		return 1
	}

	server_url="$(cfg server_url 'https://multica.lucky.jmsu.top')"
	app_url="$(cfg app_url 'https://multica.lucky.jmsu.top')"
	case "$server_url:$app_url" in
		https://*:https://*) ;;
		*) log_error "Multica server_url and app_url must both use HTTPS"; return 1 ;;
	esac
	case "$server_url$app_url" in
		*@*) log_error "Multica URLs must not contain embedded credentials"; return 1 ;;
	esac
	for value in "$server_url" "$app_url" "$token" "$workspace_id"; do
		if has_control_character "$value"; then
			log_error "Multica configuration contains an invalid control character"
			return 1
		fi
	done

	device_name="$(derive_device_name "$(cfg device_name '')")"
	runtime_name="$(cfg runtime_name 'Pi on OpenWrt')"
	runtime_provider="$(cfg runtime_provider 'pi')"
	workspaces_root="$(cfg workspaces_root '/data/multica/workspaces')"
	max_tasks="$(cfg max_concurrent_tasks '1')"
	poll_interval="$(cfg poll_interval '30s')"
	heartbeat_interval="$(cfg heartbeat_interval '15s')"

	case "$max_tasks" in
		''|*[!0-9]*) log_error "max_concurrent_tasks must be an integer from 1 to $MAX_TASKS_LIMIT"; return 1 ;;
	esac
	if [ "$max_tasks" -lt 1 ] || [ "$max_tasks" -gt "$MAX_TASKS_LIMIT" ]; then
		log_error "max_concurrent_tasks must be from 1 to $MAX_TASKS_LIMIT"
		return 1
	fi
	valid_duration "$poll_interval" || {
		log_error "poll_interval must be a positive duration using ms, s, m, or h"
		return 1
	}
	valid_duration "$heartbeat_interval" || {
		log_error "heartbeat_interval must be a positive duration using ms, s, m, or h"
		return 1
	}
	case "$runtime_provider" in
		*[!A-Za-z0-9_-]*|'') log_error "runtime_provider contains invalid characters"; return 1 ;;
	esac
	case "$workspaces_root" in
		/data/*) ;;
		*) log_error "workspaces_root must be an absolute path below /data"; return 1 ;;
	esac

	# Agent state must never silently fall back to the root overlay.
	grep -qsE '[[:space:]]/data[[:space:]]' /proc/mounts || {
		log_error "/data is not mounted; refusing to start Multica on the root overlay"
		return 1
	}

	[ -f "$RUNTIME_ENV" ] && [ ! -L "$RUNTIME_ENV" ] || {
		log_error "$RUNTIME_ENV is unavailable; refusing to fall back to rootfs caches"
		return 1
	}
	runtime_env_mode="$(stat -c '%u:%a' "$RUNTIME_ENV" 2>/dev/null || true)"
	case "$runtime_env_mode" in
		0:600|0:400) ;;
		*) log_error "$RUNTIME_ENV must be a root-owned private regular file"; return 1 ;;
	esac
	uv_cache_dir="$(runtime_env_value UV_CACHE_DIR)" || return 1
	uv_python_install_dir="$(runtime_env_value UV_PYTHON_INSTALL_DIR)" || return 1
	uv_python_cache_dir="$(runtime_env_value UV_PYTHON_CACHE_DIR)" || return 1
	pnpm_store_dir="$(runtime_env_value PNPM_STORE_DIR)" || return 1
	npm_config_cache="$(runtime_env_value NPM_CONFIG_CACHE)" || return 1
	xdg_cache_home="$(runtime_env_value XDG_CACHE_HOME)" || return 1

	umask 077
	config_dir="/root/.multica"
	config_json="$config_dir/config.json"
	config_tmp="$config_json.tmp.$$"
	mkdir -p "$config_dir" "$workspaces_root" /data/multica
	chmod 700 "$config_dir" /data/multica "$workspaces_root"

	cat > "$config_tmp" <<EOF
{
  "server_url": "$(json_escape "$server_url")",
  "app_url": "$(json_escape "$app_url")",
  "token": "$(json_escape "$token")",
  "workspace_id": "$(json_escape "$workspace_id")",
  "device_name": "$(json_escape "$device_name")",
  "runtime_name": "$(json_escape "$runtime_name")",
  "workspaces_root": "$(json_escape "$workspaces_root")",
  "max_concurrent_tasks": $max_tasks,
  "poll_interval": "$(json_escape "$poll_interval")",
  "heartbeat_interval": "$(json_escape "$heartbeat_interval")"
}
EOF
	chmod 600 "$config_tmp"
	mv -f "$config_tmp" "$config_json"

	procd_open_instance daemon
	procd_set_param command "$prog" daemon start --foreground \
		--max-concurrent-tasks "$max_tasks" \
		--poll-interval "$poll_interval" \
		--heartbeat-interval "$heartbeat_interval"
	procd_set_param env HOME=/root \
		MULTICA_SERVER_URL="$server_url" \
		MULTICA_DAEMON_DEVICE_NAME="$device_name" \
		MULTICA_AGENT_RUNTIME_NAME="$runtime_name" \
		MULTICA_WORKSPACES_ROOT="$workspaces_root" \
		MULTICA_WORKSPACE_ID="$workspace_id" \
		MULTICA_DAEMON_MAX_CONCURRENT_TASKS="$max_tasks" \
		MULTICA_DAEMON_POLL_INTERVAL="$poll_interval" \
		MULTICA_DAEMON_HEARTBEAT_INTERVAL="$heartbeat_interval"
	procd_append_param env \
		UV_CACHE_DIR="$uv_cache_dir" \
		UV_PYTHON_INSTALL_DIR="$uv_python_install_dir" \
		UV_PYTHON_CACHE_DIR="$uv_python_cache_dir" \
		PNPM_STORE_DIR="$pnpm_store_dir" \
		NPM_CONFIG_CACHE="$npm_config_cache" \
		npm_config_cache="$npm_config_cache" \
		XDG_CACHE_HOME="$xdg_cache_home"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -x /usr/sbin/multica-agent-bootstrap ]; then
		procd_open_instance bootstrap
		procd_set_param command /usr/sbin/multica-agent-bootstrap
		procd_set_param env HOME=/root MULTICA_BIN="$prog"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}
