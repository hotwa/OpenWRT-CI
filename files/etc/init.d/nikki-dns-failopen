#!/bin/sh /etc/rc.common

# Start after S99nikki. This service only observes the Nikki table and DNS;
# recovery is limited to restarting Nikki or deleting its stale nft table.
USE_PROCD=1
START=99
STOP=10

PROG="/usr/sbin/nikki-dns-failopen"

start_service() {
	[ -x "$PROG" ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 2
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

restart() {
	stop
	start
}
