#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG="/usr/sbin/tailscale-route-reconcile"

start_service() {
	[ -x "$PROG" ] || return 0

	procd_open_instance
	# The helper defaults to its persistent loop; the same binary remains
	# convenient for manual --once/--status checks.
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 2
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

restart() {
	stop
	start
}
