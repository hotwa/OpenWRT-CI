#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

DNS_DOMAIN="hs.jmsu.top"
DEVICE="tailscale0"
MAGICDNS="100.100.100.100"
DEFAULT_DNSMASQ_SERVER="/hs.jmsu.top/100.100.100.100@tailscale0"

# sbwml mosdns (v5) compatibility. When mosdns is installed it regenerates
# /var/etc/mosdns.json and may rewrite dnsmasq upstream servers, which would
# otherwise drop the Quad100 route for hs.jmsu.top. We drop a small include
# fragment and merge it into the generated config with jq so MagicDNS keeps
# working after mosdns profile switches/reloads.
MOSDNS_INCLUDE="/etc/mosdns/tailscale-magicdns.yaml"
MOSDNS_RUNTIME_JSON="/var/etc/mosdns.json"

dhcp_changed=0

ensure_list_entry() {
	local option="$1" value="$2" current
	current="$(uci -q get "$option" 2>/dev/null | tr ' ' '\n')"
	printf '%s\n' "$current" | grep -Fx "$value" >/dev/null 2>&1 && return 0
	uci add_list "$option=$value" || return 1
	dhcp_changed=1
}

apply_dnsmasq() {
	# Controller bootstrap names never depend on Tailnet DNS. The hs.jmsu.top
	# suffix is the only fail-closed route through Quad100 and tailscale0.
	ensure_list_entry "dhcp.@dnsmasq[0].server" "/headscale.jmsu.top/223.5.5.5"
	ensure_list_entry "dhcp.@dnsmasq[0].server" "/headplane.jmsu.top/223.5.5.5"
	ensure_list_entry "dhcp.@dnsmasq[0].server" "/derper.jmsu.top/223.5.5.5"
	ensure_list_entry "dhcp.@dnsmasq[0].server" "$DEFAULT_DNSMASQ_SERVER"
	ensure_list_entry "dhcp.@dnsmasq[0].rebind_domain" "$DNS_DOMAIN"

	if [ "$dhcp_changed" -eq 1 ]; then
		uci commit dhcp
		# A reload is sufficient and avoids interrupting leases. sbwml mosdns
		# may replace dnsmasq's server list during its own reload; the dhcp
		# procd trigger below runs this guard again after that commit.
		[ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq reload >/dev/null 2>&1 || true
	fi
}

apply_mosdns_compat() {
	# Best-effort: if jq or mosdns is absent this is a no-op and must never
	# block the dnsmasq path above.
	command -v jq >/dev/null 2>&1 || return 0
	[ -d /etc/mosdns ] || return 0

	mkdir -p /etc/mosdns 2>/dev/null || true

	# Write the mosdns v5 fragment: forward hs.jmsu.top to Quad100 bound to
	# tailscale0 via the forward_tailscale_magicdns exec.
	cat >"$MOSDNS_INCLUDE" <<EOF
# Tailscale MagicDNS compatibility fragment for mosdns v5.
# Managed by /etc/init.d/tailscale-dns-mode-guard; do not edit manually.
plugins:
  - name: forward_tailscale_magicdns
    type: forward
    args:
      upstreams:
        - addr: "${MAGICDNS}:53"
          enable_pipeline: true
          bind_to_device: "${DEVICE}"
  - name: tailscale_magicdns_sequence
    type: sequence
    args:
      - exec: \$forward_tailscale_magicdns
    matches:
      - qname suffix: "${DNS_DOMAIN}"
EOF

	# Merge the include into the generated /var/etc/mosdns.json when it
	# exists and carries an include array. Idempotent: skip if already listed.
	if [ -f "$MOSDNS_RUNTIME_JSON" ]; then
		local tmp
		tmp="$(mktemp 2>/dev/null)" || return 0
		if jq --arg inc "$MOSDNS_INCLUDE" \
			'(if (.include | type) == "array" then .include else [] end) as $i
			 | if ($i | index($inc)) then . else .include = ($i + [$inc]) end' \
			"$MOSDNS_RUNTIME_JSON" >"$tmp" 2>/dev/null; then
			cat "$tmp" >"$MOSDNS_RUNTIME_JSON" 2>/dev/null || true
		fi
		rm -f "$tmp"
	fi

	return 0
}

apply_guard() {
	command -v uci >/dev/null 2>&1 || return 0
	dhcp_changed=0
	apply_dnsmasq
	apply_mosdns_compat
}

start_service() {
	apply_guard
}

reload_service() {
	apply_guard
}

service_triggers() {
	# mosdns rewrites and commits dhcp.server when its redirect mode changes.
	# Watching both configs makes the domain-specific Quad100 route survive
	# package/profile updates without patching generated mosdns JSON.
	procd_add_reload_trigger "dhcp"
	procd_add_reload_trigger "mosdns"
}
