#!/bin/sh /etc/rc.common

# opencode-runtime: trigger first-boot binary download and maintain config links.
# START=92 runs after agent-runtime (91) and before multica (95), so the
# opencode binary is on PATH when Multica's daemon probes for runtime providers.

START=92
STOP=10

start() {
	# opencode is intentionally not provisioned on low-memory devices
	# (re-ss-01, 896MB RAM): firmware built for that board ships without
	# /etc/opencode/release-url, so every opencode component is a no-op here.
	[ -f /etc/opencode/release-url ] || {
		logger -t opencode-runtime "opencode not enabled on this device (no release metadata)"
		return 0
	}

	# Kick off the first-boot install in the background.  The 185 MB download
	# can take several minutes; we must not block the boot sequence.
	if [ -x /usr/sbin/opencode-runtime ]; then
		( /usr/sbin/opencode-runtime install >/tmp/opencode-runtime-install.log 2>&1 ) &
		logger -t opencode-runtime "first-boot install started in background"
	fi

	# Maintain data-backed config directories and symlinks (idempotent).
	if [ -d /data ] && [ -w /data ]; then
		mkdir -p /data/opencode/config/opencode /data/opencode/cache \
			/data/opencode/data /data/opencode/state

		# opencode 1.18+ reads $XDG_CONFIG_HOME/opencode/opencode.json
		# (it appends an "opencode" subdirectory under XDG_CONFIG_HOME), NOT
		# the flat $XDG_CONFIG_HOME/opencode.json.  The flat path was written
		# by older firmware and is ignored by the running binary, leaving the
		# CommandCode provider unconfigured.  Target the nested path here.
		CONFIG_DIR=/data/opencode/config/opencode
		CONFIG_FILE="$CONFIG_DIR/opencode.json"

		# The role may already exist on upgrades; Multica repairs this again
		# after rendering it on first boot. Missing roles are a safe no-op.
		if [ -x /usr/sbin/opencode-role-link ]; then
			OPENCODE_CONFIG_DIR="$CONFIG_DIR" /usr/sbin/opencode-role-link || \
				logger -t opencode-runtime "could not repair OpenCode role link"
		fi

		# Upgrade migration: carry over a config written to the old flat path.
		if [ -f /data/opencode/config/opencode.json ] && [ ! -f "$CONFIG_FILE" ]; then
			cp -p /data/opencode/config/opencode.json "$CONFIG_FILE"
			logger -t opencode-runtime "migrated flat opencode.json to nested path"
		fi

		# First-boot migration: copy firmware default config if absent.
		if [ ! -f "$CONFIG_FILE" ] && \
			[ -f /etc/opencode/opencode.json ]; then
			cp /etc/opencode/opencode.json "$CONFIG_FILE"
			chmod 0644 "$CONFIG_FILE"
			logger -t opencode-runtime "copied default opencode.json to nested /data path"
		fi

		# Upgrade migration: if the existing /data config predates the
		# CommandCode provider (no "commandcode" key), back it up and replace
		# with the firmware default so all devices get the provider config.
		# Idempotent: once the config contains "commandcode" this is skipped.
		if [ -f "$CONFIG_FILE" ] && \
			[ -f /etc/opencode/opencode.json ] && \
			! grep -q '"commandcode"' "$CONFIG_FILE" 2>/dev/null; then
			cp -p "$CONFIG_FILE" \
				"$CONFIG_FILE.bak.$(date +%Y%m%d%H%M%S 2>/dev/null || echo pre-commandcode)"
			cp /etc/opencode/opencode.json "$CONFIG_FILE"
			chmod 0644 "$CONFIG_FILE"
			logger -t opencode-runtime "migrated opencode.json to include CommandCode provider (backup kept)"
		fi

		# Default-XDG compatibility must point at the effective app directory.
		# Only repair our known legacy link; keep user directories and links.
		mkdir -p /root/.config
		if [ -L /root/.config/opencode ]; then
			if [ "$(readlink /root/.config/opencode)" = /data/opencode/config ]; then
				ln -sfn "$CONFIG_DIR" /root/.config/opencode
			fi
		elif [ ! -e /root/.config/opencode ]; then
			ln -s "$CONFIG_DIR" /root/.config/opencode
		fi
	fi
}

restart() {
	start
}
