#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
    # A public image carries no site credential. A restored private config
    # starts on the next boot without an enrollment loop or baked-in secret.
    [ -s /etc/pi-dhcp-sync/site ] || return 0
    [ -s /etc/pi-dhcp-sync/curl.conf ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/pi-dhcp-sync loop
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
