#!/bin/sh /etc/rc.common

START=99
STOP=10

PROBE_HOST="100.100.100.100"
PROBE_PORT="53"
PROBE_TAG="tailscale-quad100-health"

tailnet_ready() {
	ip link show dev tailscale0 >/dev/null 2>&1 || return 1
	tailscale status --json 2>/dev/null |
		grep -q '"BackendState"[[:space:]]*:[[:space:]]*"Running"'
}

probe_quad100() {
	local probe_name lookup_output

	# Quad100 is a MagicDNS resolver, not a public recursive resolver. Resolve
	# the node's current MagicDNS name so renames do not require a new image.
	probe_name="$(tailscale status --json 2>/dev/null |
		jsonfilter -e '@.Self.DNSName' 2>/dev/null || true)"
	probe_name="${probe_name%.}"
	case "$probe_name" in
		''|*[!A-Za-z0-9_.-]*)
			logger -t "$PROBE_TAG" "skipping Quad100 DNS probe because Self.DNSName is unavailable"
			return 0
		;;
	esac

	if command -v nslookup >/dev/null 2>&1; then
		lookup_output="$(nslookup "$probe_name" "$PROBE_HOST" 2>/dev/null || true)"
		# Matching Name: avoids accepting the resolver's own Address: line when
		# the query returns SERVFAIL.
		echo "$lookup_output" | grep -q 'Name:'
		return $?
	fi

	# BusyBox nc must use -u: -z without it probes TCP 53 and always fails on
	# Quad100 deployments that intentionally expose DNS only over UDP.
	if command -v nc >/dev/null 2>&1; then
		nc -uz -w 2 "$PROBE_HOST" "$PROBE_PORT" >/dev/null 2>&1
		return $?
	fi

	logger -t "$PROBE_TAG" "skipping Quad100 health probe because neither nslookup nor nc is available"
	return 0
}

start() {
	local attempt=0

	pgrep -x tailscaled >/dev/null 2>&1 || return 0
	if ! tailnet_ready; then
		logger -t "$PROBE_TAG" "skip Quad100 probe until tailscale0 is ready"
		return 0
	fi

	while [ "$attempt" -lt 5 ]; do
		if probe_quad100; then
			logger -t tailscale-quad100-health "Quad100 MagicDNS probe succeeded on ${PROBE_HOST}:${PROBE_PORT} after $((attempt + 1)) attempt(s)"
			return 0
		fi

		attempt=$((attempt + 1))
		sleep 2
	done

	logger -t tailscale-quad100-health "Quad100 MagicDNS probe failed on ${PROBE_HOST}:${PROBE_PORT} after ${attempt} attempt(s)"
	return 0
}

restart() {
	start
}
