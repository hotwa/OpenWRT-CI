#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/tailscale-quad100-health-monitor
	# This is a real long-running monitor loop, not a one-shot worker. Its
	# bounded respawn protects against a crashed monitor without a tight loop.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
