#!/bin/sh /etc/rc.common

START=90
STOP=10

DATA_ROOT="${UV_STORAGE_DATA_ROOT:-/data}"
MOUNTS_FILE="${UV_STORAGE_MOUNTS_FILE:-/proc/mounts}"
RUNTIME_ENV="${UV_STORAGE_RUNTIME_ENV:-/tmp/uv-env.sh}"

data_is_ready() {
	local probe="$DATA_ROOT/.uv-storage-write-probe.$$"
	awk -v target="$DATA_ROOT" '$2 == target { found=1 } END { exit !found }' \
		"$MOUNTS_FILE" 2>/dev/null || return 1
	[ -d "$DATA_ROOT" ] && [ ! -L "$DATA_ROOT" ] || return 1
	( umask 077; : >"$probe" ) 2>/dev/null || return 1
	rm -f "$probe"
}

write_runtime_env() {
	local temporary="${RUNTIME_ENV}.new.$$"

	data_is_ready || {
		rm -f "$RUNTIME_ENV" "$temporary" 2>/dev/null || true
		return 1
	}
	mkdir -p \
		"$DATA_ROOT/uv_cache" \
		"$DATA_ROOT/uv/python" \
		"$DATA_ROOT/uv/python-cache" \
		"$DATA_ROOT/pnpm/store" \
		"$DATA_ROOT/npm/cache" \
		"$DATA_ROOT/cache" || return 1
	chmod 0700 \
		"$DATA_ROOT/uv_cache" \
		"$DATA_ROOT/uv" \
		"$DATA_ROOT/pnpm" \
		"$DATA_ROOT/npm" \
		"$DATA_ROOT/cache" 2>/dev/null || true

	( umask 077; cat >"$temporary" <<EOF
export MULTICA_WORKSPACE=$DATA_ROOT/multica
export MULTICA_DATA_DIR=$DATA_ROOT/multica
export UV_CACHE_DIR=$DATA_ROOT/uv_cache
export UV_PYTHON_INSTALL_DIR=$DATA_ROOT/uv/python
export UV_PYTHON_CACHE_DIR=$DATA_ROOT/uv/python-cache
export PNPM_STORE_DIR=$DATA_ROOT/pnpm/store
export NPM_CONFIG_CACHE=$DATA_ROOT/npm/cache
export npm_config_cache=$DATA_ROOT/npm/cache
# /data/node is a compatibility symlink managed by agent-runtime (START=91).
# It points at the active immutable generation; direct npm writes are refused.
export NPM_CONFIG_PREFIX=$DATA_ROOT/node
export npm_config_prefix=$DATA_ROOT/node
export PNPM_HOME=$DATA_ROOT/node/bin
export XDG_CACHE_HOME=$DATA_ROOT/cache
EOF
	) || return 1
	mv "$temporary" "$RUNTIME_ENV"
}

start() {
	write_runtime_env
}

restart() {
	start
}
