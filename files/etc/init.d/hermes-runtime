#!/bin/sh /etc/rc.common
# One-shot local Hermes Core health coordinator. The Core is baked into /opt
# (or selected by agent-runtime), so it must never wait for WAN at boot.

START=96
STOP=10

PROVISIONER="/usr/sbin/hermes-runtime-provision"
PID_FILE="/var/run/hermes-runtime-provision.pid"

start() {
	[ -x "$PROVISIONER" ] || return 0
	start-stop-daemon -S -b -p "$PID_FILE" -x "$PROVISIONER" ||
		echo "hermes-runtime: unable to start local health coordinator" >&2
}

stop() {
	start-stop-daemon -K -p "$PID_FILE" -x "$PROVISIONER" 2>/dev/null || true
	rm -f "$PID_FILE"
}

restart() {
	stop
	start
}
