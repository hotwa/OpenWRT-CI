diff --git a/files/usr/bin/cf-ip-speed-client b/files/usr/bin/cf-ip-speed-client
--- a/files/usr/bin/cf-ip-speed-client
+++ b/files/usr/bin/cf-ip-speed-client
@@ -764,6 +764,8 @@ install_cron() {
 	sed -i "\|# cf-ip-speed-client|d" /etc/crontabs/root 2>/dev/null || true
