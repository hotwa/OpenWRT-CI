diff --git a/files/etc/config/cf_ip_speed_client b/files/etc/config/cf_ip_speed_client
--- a/files/etc/config/cf_ip_speed_client
+++ b/files/etc/config/cf_ip_speed_client
@@ -1,13 +1,13 @@
 config client 'main'
 	# Point this at your own deployment when self-hosting; the client no longer needs patching.
 	option worker_url 'https://cf.6610000.xyz'
