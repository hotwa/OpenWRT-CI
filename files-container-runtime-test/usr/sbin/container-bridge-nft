#!/bin/sh

set -u

PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin
export PATH

TAG="container-bridge-nft"
BRIDGE="ctrbr-nft0"
NETWORK="bridge"
DEFAULT_SUBNET="10.250.0.0/24"
SUBNET="$DEFAULT_SUBNET"
ZONE="container_bridge_nft"
CNI_TEMPLATE="/usr/share/container-runtime/nerdctl-bridge.conflist.in"
[ -n "${CONTAINER_BRIDGE_NFT_CNI_TEMPLATE:-}" ] && CNI_TEMPLATE="$CONTAINER_BRIDGE_NFT_CNI_TEMPLATE"
CNI_ACTIVE="/etc/cni/net.d/nerdctl-bridge.conflist"
[ -n "${CONTAINER_BRIDGE_NFT_CNI_ACTIVE:-}" ] && CNI_ACTIVE="$CONTAINER_BRIDGE_NFT_CNI_ACTIVE"
NFT_TEMPLATE="/usr/share/container-runtime/container-bridge-nft.nft"
[ -n "${CONTAINER_BRIDGE_NFT_NFT_TEMPLATE:-}" ] && NFT_TEMPLATE="$CONTAINER_BRIDGE_NFT_NFT_TEMPLATE"
NFT_ACTIVE="/etc/nftables.d/99-container-bridge-nft.nft"
[ -n "${CONTAINER_BRIDGE_NFT_NFT_ACTIVE:-}" ] && NFT_ACTIVE="$CONTAINER_BRIDGE_NFT_NFT_ACTIVE"
STATE_DIR="/data/containerd/nerdctl"
[ -n "${CONTAINER_BRIDGE_NFT_STATE_DIR:-}" ] && STATE_DIR="$CONTAINER_BRIDGE_NFT_STATE_DIR"
SUBNET_FILE="$STATE_DIR/bridge-subnet"
[ -n "${CONTAINER_BRIDGE_NFT_SUBNET_FILE:-}" ] && SUBNET_FILE="$CONTAINER_BRIDGE_NFT_SUBNET_FILE"

IP_CMD="${CONTAINER_BRIDGE_NFT_IP:-ip}"
UCI_CMD="${CONTAINER_BRIDGE_NFT_UCI:-uci}"
PROC_MOUNTS="${CONTAINER_BRIDGE_NFT_PROC_MOUNTS:-/proc/mounts}"

log() {
	logger -t "$TAG" "$*" 2>/dev/null || true
	echo "$TAG: $*"
}

data_mount_ready() {
	awk '$2 == "/data" && $1 ~ /^\/dev\// && ($3 == "ext4" || $3 == "f2fs") { found = 1 } END { exit !found }' "$PROC_MOUNTS"
}

lan_device() {
	local device
	device="$($UCI_CMD -q get network.lan.device 2>/dev/null || true)"
	[ -n "$device" ] || device="$($UCI_CMD -q get network.lan.ifname 2>/dev/null || true)"
	[ -n "$device" ] || device="br-lan"
	printf '%s' "$device"
}

candidate_inventory_is_safe() {
	# Check every table, including prefixes broader/narrower than the /24.
	# An exact-prefix query alone misses blackhole supernets and host routes.
	printf '%s\n' "$2" | awk -v candidate="$1" -v bridge="$BRIDGE" -v lan="$3" '
		function block_size(bits, result) {
			# BusyBox awk can be built without floating-point math/pow().
			result = 1
			while (bits++ < 32) result *= 2
			return result
		}
		function address(value, octets, count, i, result) {
			count = split(value, octets, ".")
			if (count != 4) return -1
			result = 0
			for (i = 1; i <= 4; i++) {
				if (octets[i] !~ /^[0-9]+$/ || octets[i] > 255) return -1
				result = result * 256 + octets[i]
			}
			return result
		}
		function overlaps(value, parts, count, base, bits, size, first) {
			if (value == "default") value = "0.0.0.0/0"
			count = split(value, parts, "/")
			base = address(parts[1])
			bits = count == 1 ? 32 : parts[2]
			# Unknown route syntax cannot establish safety.
			if (base < 0 || count > 2 || bits !~ /^[0-9]+$/ || bits > 32) return 1
			size = block_size(bits)
			first = int(base / size) * size
			return first <= candidate_last && first + size - 1 >= candidate_first
		}
		BEGIN {
			split(candidate, selected, "/")
			size = block_size(selected[2])
			candidate_first = int(address(selected[1]) / size) * size
			candidate_last = candidate_first + size - 1
		}
		$1 ~ /^(unreachable|blackhole|prohibit|throw)$/ {
			if (overlaps($2)) conflict = 1
			next
		}
		{
			prefix = $1 ~ /^(unicast|local)$/ ? $2 : $1
			if (prefix == "default" || prefix == "0.0.0.0/0" ||
			    $1 ~ /^(broadcast|multicast|anycast)$/) next
			device = ""; via = 0
			for (i = 1; i < NF; i++) {
				if ($i == "dev") device = $(i + 1)
				if ($i == "via") via = 1
			}
			protected = device == lan || device == "br-lan" || device == "tailscale0" ||
			            device == "nikki" || device ~ /^tun/
			if (device != "" && device != bridge && (!via || protected) && overlaps(prefix)) conflict = 1
		}
		END { exit conflict ? 1 : 0 }
	'
}

candidate_route_is_safe() {
	local subnet="$1" gateway="$2" route query lan routes route_device
	lan="$(lan_device)"
	routes="$($IP_CMD -4 route show table all 2>/dev/null)" || return 1
	candidate_inventory_is_safe "$subnet" "$routes" "$lan" || return 1

	# A candidate must not be routed into LAN, Tailnet, Nikki, or another
	# directly connected interface. A normal default route is safe because the
	# nft policy owns the later masquerade/mark decision.
	for query in ""; do
		route="$(LC_ALL=C $IP_CMD -4 route get "$gateway" $query 2>&1 || true)"
		[ -n "$route" ] || return 1
		# Pad the final token so protected devices also match at end-of-line.
		case "$route " in
			unreachable*|"RTNETLINK answers: Network is unreachable "|"ip: RTNETLINK answers: Network is unreachable ")
				# No route, or an unresolved PPPoE default, is not by itself
				# an explicit policy. The table inventory above already rejects
				# overlapping negative/connected routes, even without a WAN.
				;;
			*" dev $lan "*|*" dev br-lan "*|*" dev tailscale0 "*|*" dev nikki "*|*" dev tun"*)
				return 1
				;;
			*" dev $BRIDGE "*)
				# Reusing the persisted subnet after reboot is allowed.
				;;
			*" via "*)
				# The candidate follows a routed default path.
				;;
			*" dev pppoe-"*|*" dev ppp"[0-9]*)
				# Point-to-point WAN defaults need not contain a "via" peer.
				# Require a matching unicast default, not merely a PPP name.
				route_device="$(printf '%s\n' "$route" | awk '{ for (i=1; i<NF; i++) if ($i == "dev") { print $(i+1); exit } }')"
				printf '%s\n' "$routes" | awk -v device="$route_device" '
					$1 == "default" { for (i=1; i<NF; i++) if ($i == "dev" && $(i+1) == device) found=1 }
					END { exit !found }
				' || return 1
				;;
			local*)
				# "ip route get" reports "local" when the gateway is an address
				# already assigned to this host. For the persisted container
				# subnet this normally means our own bridge still holds it
				# after a restart, so the subnet is safe to reuse. Only allow
				# reuse when the address really lives on our bridge; a local
				# address on any other interface is a genuine overlap.
				if $IP_CMD -4 addr show dev "$BRIDGE" 2>/dev/null | grep -Fq "$gateway/"; then
					:
				else
					return 1
				fi
				;;
			*)
				# A connected route on any other interface is ambiguous and is
				# safer to reject than to overlap silently.
				return 1
				;;
		esac
	done

	# Avoid colliding with another CNI network even if that network has not
	# created its link yet. The generated default file is the only exception.
	for config in "$(dirname "$CNI_ACTIVE")"/*; do
		[ -f "$config" ] || continue
		[ "$config" = "$CNI_ACTIVE" ] && continue
		grep -Fq "\"$subnet\"" "$config" 2>/dev/null && return 1
	done

	# No conflict found; the loop above must not leak its exit status
	# (a non-matching grep returns 1) into this function's result.
	return 0
}

select_subnet() {
	local saved candidate subnet gateway

	[ -r "$SUBNET_FILE" ] && {
		saved="$(sed -n '1p' "$SUBNET_FILE")"
		case "$saved" in
			10.*.0.0/24|172.30.0.0/24|172.31.0.0/24)
				subnet="$saved"
				gateway="${subnet%0/24}1"
				if candidate_route_is_safe "$subnet" "$gateway"; then
					SUBNET="$subnet"
					return 0
				fi
				log "persisted subnet $subnet overlaps an active route; selecting a new subnet"
				;;
		esac
	}

	for candidate in \
		"10.250.0.0/24" \
		"10.251.0.0/24" \
		"10.252.0.0/24" \
		"10.253.0.0/24" \
		"10.254.0.0/24" \
		"172.30.0.0/24" \
		"172.31.0.0/24"; do
		gateway="${candidate%0/24}1"
		if candidate_route_is_safe "$candidate" "$gateway"; then
			SUBNET="$candidate"
			return 0
		fi
	done

	log "no unused container subnet is available"
	return 1
}

persist_subnet() {
	local temporary="$SUBNET_FILE.new.$$"
	mkdir -p "$STATE_DIR" || return 1
	printf '%s\n' "$SUBNET" > "$temporary" || return 1
	chmod 0600 "$temporary" 2>/dev/null || true
	mv -f "$temporary" "$SUBNET_FILE" || {
		rm -f "$temporary"
		return 1
	}
}

render_cni_config() {
	local temporary
	[ -r "$CNI_TEMPLATE" ] || {
		log "missing CNI template: $CNI_TEMPLATE"
		return 1
	}
	if [ -L "$CNI_ACTIVE" ]; then
		log "refusing to replace symlinked CNI config: $CNI_ACTIVE"
		return 1
	fi
	mkdir -p "$(dirname "$CNI_ACTIVE")" || return 1
	temporary="$CNI_ACTIVE.new.$$"
	sed "s|__CONTAINER_SUBNET__|$SUBNET|g" "$CNI_TEMPLATE" > "$temporary" || {
		rm -f "$temporary"
		return 1
	}
	chmod 0644 "$temporary" || {
		rm -f "$temporary"
		return 1
	}
	mv -f "$temporary" "$CNI_ACTIVE" || {
		rm -f "$temporary"
		return 1
	}
}

remove_cni_config() {
	if [ -f "$CNI_ACTIVE" ] && \
		grep -Fq '"bridge": "ctrbr-nft0"' "$CNI_ACTIVE" && \
		grep -Fq '"nerdctl/default-network": "true"' "$CNI_ACTIVE"; then
		rm -f "$CNI_ACTIVE"
	fi
}

ensure_firewall_zone() {
	$UCI_CMD -q get "firewall.$ZONE" >/dev/null 2>&1 || \
		$UCI_CMD set "firewall.$ZONE=zone" || return 1
	$UCI_CMD set "firewall.$ZONE.name=$ZONE" || return 1
	$UCI_CMD set "firewall.$ZONE.device=$BRIDGE" || return 1
	$UCI_CMD set "firewall.$ZONE.input=ACCEPT" || return 1
	$UCI_CMD set "firewall.$ZONE.output=ACCEPT" || return 1
	$UCI_CMD set "firewall.$ZONE.forward=ACCEPT"
}

ensure_forwarding() {
	local section="$1"
	local source="$2"
	local destination="$3"
	$UCI_CMD -q get "firewall.$section" >/dev/null 2>&1 || \
		$UCI_CMD set "firewall.$section=forwarding" || return 1
	$UCI_CMD set "firewall.$section.src=$source" || return 1
	$UCI_CMD set "firewall.$section.dest=$destination"
}

install_nft_policy() {
	local temporary
	[ -r "$NFT_TEMPLATE" ] || {
		log "missing nft policy template: $NFT_TEMPLATE"
		return 1
	}
	if [ -e "$NFT_ACTIVE" ] && ! grep -Fq 'container bridge return-path NAT' "$NFT_ACTIVE"; then
		log "refusing to replace unrelated nft file: $NFT_ACTIVE"
		return 1
	fi
	mkdir -p "$(dirname "$NFT_ACTIVE")" || return 1
	temporary="$NFT_ACTIVE.new.$$"
	sed "s|__CONTAINER_SUBNET__|$SUBNET|g" "$NFT_TEMPLATE" > "$temporary" || {
		rm -f "$temporary"
		return 1
	}
	chmod 0644 "$temporary" || {
		rm -f "$temporary"
		return 1
	}
	mv -f "$temporary" "$NFT_ACTIVE" || {
		rm -f "$temporary"
		return 1
	}
}

remove_nft_policy() {
	if [ -f "$NFT_ACTIVE" ] && grep -Fq 'container bridge return-path NAT' "$NFT_ACTIVE"; then
		rm -f "$NFT_ACTIVE"
	fi
}

reload_firewall() {
	if [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || return 1
	else
		fw4 reload >/dev/null 2>&1 || return 1
	fi
}

remove_firewall_config() {
	$UCI_CMD -q delete "firewall.$ZONE" 2>/dev/null || true
	$UCI_CMD -q delete "firewall.${ZONE}_to_wan" 2>/dev/null || true
	$UCI_CMD -q delete "firewall.${ZONE}_to_lan" 2>/dev/null || true
	$UCI_CMD -q delete "firewall.${ZONE}_to_tailscale" 2>/dev/null || true
	$UCI_CMD -q delete "firewall.lan_to_${ZONE}" 2>/dev/null || true
	$UCI_CMD -q delete "firewall.tailscale_to_${ZONE}" 2>/dev/null || true
	$UCI_CMD commit firewall
}

configure_uci() {
	ensure_firewall_zone || return 1

	ensure_forwarding "${ZONE}_to_wan" "$ZONE" wan || return 1
	ensure_forwarding "${ZONE}_to_lan" "$ZONE" lan || return 1
	ensure_forwarding "${ZONE}_to_tailscale" "$ZONE" tailscale || return 1
	ensure_forwarding "lan_to_${ZONE}" lan "$ZONE" || return 1
	ensure_forwarding "tailscale_to_${ZONE}" tailscale "$ZONE" || return 1

	$UCI_CMD commit firewall
}

enable_bridge() {
	data_mount_ready || {
		log "refusing to enable: /data is not a real ext4/f2fs block mount"
		return 1
	}
	select_subnet || return 1
	persist_subnet || {
		log "failed to persist selected subnet $SUBNET"
		return 1
	}
	render_cni_config || return 1
	install_nft_policy || {
		remove_cni_config
		return 1
	}
	configure_uci || {
		remove_nft_policy
		remove_cni_config
		log "failed to write UCI configuration"
		return 1
	}

	# This only reloads firewall; it does not reload netifd or Nikki, so CNI's
	# bridge remains solely owned by the bridge plugin and existing links are
	# not brought down by the boot-time enable operation.
	if ! reload_firewall; then
		log "firewall reload failed; rolling back bridge+nft policy"
		remove_nft_policy
		remove_cni_config
		remove_firewall_config
		reload_firewall || true
		return 1
	fi
	log "enabled: default nerdctl network is $NETWORK (subnet $SUBNET, ipMasq=false)"
}

disable_bridge() {
	remove_firewall_config
	remove_nft_policy
	remove_cni_config
	reload_firewall || log "firewall reload failed during disable"
	log "disabled: generated default bridge config and policy removed"
}

show_status() {
	local active_subnet=""
	[ -r "$SUBNET_FILE" ] && active_subnet="$(sed -n '1p' "$SUBNET_FILE")"
	[ -n "$active_subnet" ] || active_subnet="$DEFAULT_SUBNET (not selected yet)"
	echo "network=$NETWORK"
	echo "bridge=$BRIDGE"
	echo "subnet=$active_subnet"
	echo "cni_config=$CNI_ACTIVE"
	echo "--- UCI network ---"
	echo "not managed (CNI owns $BRIDGE)"
	echo "--- UCI firewall ---"
	$UCI_CMD -q show "firewall.$ZONE" 2>/dev/null || echo "not configured"
	echo "--- bridge link ---"
	ip -br addr show "$BRIDGE" 2>/dev/null || echo "bridge not created"
	echo "--- nft policy ---"
	[ -f "$NFT_ACTIVE" ] && echo "enabled: $NFT_ACTIVE" || echo "disabled"
}

# TESTING mode: define all functions but skip command dispatch so tests can
# source the script and invoke functions directly.  Use return (not exit) so
# that sourcing the script does not terminate the caller's shell.
if [ "${CONTAINER_BRIDGE_NFT_TESTING:-0}" = "1" ]; then
	return 0 2>/dev/null || exit 0
fi

case "${1:-status}" in
	enable|start)
		enable_bridge
		;;
	disable|stop)
		disable_bridge
		;;
	status)
		show_status
		;;
	apply|reload)
		reload_firewall || log "firewall reload failed during apply"
		;;
	*)
		echo "Usage: $0 {enable|disable|status|apply}" >&2
		exit 2
		;;
esac
