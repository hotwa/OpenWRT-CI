{
  "cniVersion": "1.0.0",
  "name": "bridge",
  "nerdctlLabels": {
    "nerdctl/default-network": "true"
  },
  "plugins": [
    {
      "type": "bridge",
      "bridge": "ctrbr-nft0",
      "isGateway": true,
      "ipMasq": false,
      "hairpinMode": true,
      "ipam": {
        "type": "host-local",
        "ranges": [[
          {
            "subnet": "__CONTAINER_SUBNET__"
          }
        ]],
        "routes": [
          {
            "dst": "0.0.0.0/0"
          }
        ]
      }
    },
    {
      "type": "tuning"
    }
  ]
}
