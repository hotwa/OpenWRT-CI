#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CONFIG_FILE="/etc/containerd/containerd-test.toml"

data_mount_ready() {
	awk '$2 == "/data" && $1 ~ /^\/dev\// && ($3 == "ext4" || $3 == "f2fs") { found = 1 } END { exit !found }' /proc/mounts
}

cgroup_ready() {
	local controller
	[ -f /sys/fs/cgroup/cgroup.controllers ] || return 1
	[ -f /sys/fs/cgroup/cgroup.subtree_control ] || return 1
	for controller in cpu memory pids; do
		grep -qw "$controller" /sys/fs/cgroup/cgroup.controllers || {
			logger -t containerd-test "required cgroup controller is unavailable: $controller"
			return 1
		}
		grep -qw "$controller" /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || \
			echo "+$controller" >> /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || true
		grep -qw "$controller" /sys/fs/cgroup/cgroup.subtree_control 2>/dev/null || {
			logger -t containerd-test "required cgroup controller is not enabled: $controller"
			return 1
		}
	done
}

runtime_binaries_ready() {
	local binary
	for binary in /usr/bin/containerd /usr/bin/containerd-shim-runc-v2 /usr/bin/ctr /usr/bin/nerdctl /usr/sbin/runc; do
		[ -x "$binary" ] || {
			logger -t containerd-test "refusing to start: missing runtime binary $binary"
			return 1
		}
	done
}

prepare_runtime_dirs() {
	mkdir -p /data/containerd/root /data/containerd/nerdctl /run/containerd
}

bridge_ready() {
	local run_without_bridge
	if ! [ -x /usr/sbin/container-bridge-nft ]; then
		logger -t containerd-test "bridge+nft helper is missing or not executable"
	elif /usr/sbin/container-bridge-nft enable; then
		logger -t containerd-test "default container bridge enabled"
		return 0
	else
		logger -t containerd-test "bridge+nft policy could not be enabled"
	fi

	# Only the exact, explicit UCI value 1 permits this degraded start.
	run_without_bridge="$(uci -q get containerd-test.main.run_without_bridge 2>/dev/null)" || run_without_bridge=0
	if [ "$run_without_bridge" = 1 ]; then
		logger -t containerd-test "WARNING: run_without_bridge=1: starting without bridge+nft readiness; stale CNI may be used; Nikki network policy is not guaranteed; no network isolation is promised"
		return 0
	fi
	logger -t containerd-test "refusing to start: bridge+nft policy is not ready (run_without_bridge is not explicitly 1)"
	return 1
}

start_service() {
	if ! data_mount_ready; then
		logger -t containerd-test "refusing to start: /data is not a real ext4/f2fs block mount"
		return 0
	fi
	if ! cgroup_ready; then
		logger -t containerd-test "refusing to start: cgroup v2 controllers are not ready"
		return 0
	fi
	runtime_binaries_ready || return 0
	prepare_runtime_dirs || return 1
	bridge_ready || return 0

	procd_open_instance
	procd_set_param command /usr/bin/containerd --config "$CONFIG_FILE"
	procd_set_param env PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
